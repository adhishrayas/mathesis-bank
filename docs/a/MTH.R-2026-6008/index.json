        "doc": "The witness attached to a strictly dense subset: a family of VC dimension `1` on a ground\nset of size exactly `κ` whose traces are at least as many as the points of `J`.",
        "hypotheses": [
          {
            "name": "hκ",
            "pretty": "Cardinal.aleph0 ≤ κ"
          },
          {
            "name": "hEκ",
            "pretty": "Cardinal.mk ↑E ≤ κ"
          },
          {
            "name": "hE",
            "pretty": "IsStrictlyDenseIn E"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {κ : Cardinal.{u}} {J : Type u} [inst : LinearOrder J] {E : Set J},\n  Cardinal.aleph0 ≤ κ →\n    Cardinal.mk ↑E ≤ κ →\n      IsStrictlyDenseIn E →\n        ∃ α 𝒜 A, Cardinal.mk ↑A = κ ∧ HasVCDimLE 1 𝒜 ∧ Cardinal.mk J ≤ Cardinal.mk ↑((fun x => A ∩ x) '' 𝒜)",
        "topo": 3,
        "type_sha256": "87a117ed814600450c25336f6f6748ad172c0cda788945844fd438e69108d067"
      },
      {
