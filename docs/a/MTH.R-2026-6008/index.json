        "decl_name": "hasVCDimLE_one_of_isChain",
        "depth": 2,
        "dictionary_leaves": [
          "HasVCDimLE",
          "Shatters"
        ],
        "doc": "A family linearly ordered by inclusion has VC dimension at most `1`. Shattering a two point\nset asks for a member meeting it in the first point alone and a member meeting it in the second\npoint alone; whichever of the two members is contained in the other already contains its own\npoint, so it meets the set in both. This is why the extremal families for `ded` are families of\ncuts: the number of cuts is exactly what a chain in a linear order can achieve.",
        "hypotheses": [
          {
            "name": "h𝒜",
            "pretty": "IsChain (fun x1 x2 => x1 ⊆ x2) 𝒜"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_2} {𝒜 : Set (Set α)}, IsChain (fun x1 x2 => x1 ⊆ x2) 𝒜 → HasVCDimLE 1 𝒜",
        "topo": 7,
        "type_sha256": "d1a14bde0543b411b3475ce05e77102e48b818b319b85f3eba745413171cb764"
      },
      {
