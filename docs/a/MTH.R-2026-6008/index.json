        "pretty": "∀ {κ : Cardinal.{u}} {J P : Type u} {E : Set J},\n  Cardinal.aleph0 ≤ κ → Cardinal.mk ↑E ≤ κ → Cardinal.mk P = κ → Cardinal.mk ↑(padGround✝ E) = κ",
