      {
        "citable": false,
        "decl_name": "exists_strictly_between_fatten",
        "depth": 5,
        "dictionary_leaves": [
          "IsDenseIn",
          "fatten"
        ],
        "doc": "The heart of the comparison: in the blow-up, every pair is separated strictly by a point\nlying over `E`. The three cases of the bracketing witness `d` are `a < d < b`, where the fibre\nover `d` supplies the point; `d = a`, where the point is taken higher in the fibre over `a`; and\n`d = b`, where it is taken lower in the fibre over `b`.",
        "hypotheses": [
          {
            "name": "hE",
            "pretty": "IsDenseIn E"
          },
          {
            "name": "hu",
            "pretty": "u ∈ fatten✝ E"
          },
          {
            "name": "hv",
            "pretty": "v ∈ fatten✝ E"
          },
          {
            "name": "huv",
            "pretty": "u < v"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {J : Type u} [inst : LinearOrder J] {E : Set J},\n  IsDenseIn E →\n    ∀ {u v : Lex (J × ℚ)}, u ∈ fatten✝ E → v ∈ fatten✝ E → u < v → ∃ z ∈ E, ∃ r, u < toLex (z, r) ∧ toLex (z, r) < v",
        "topo": 19,
        "type_sha256": "a9891ed14290b9f4e82966a6ddf598599e75164e326cf4249052b5705d586550"
      },
      {
        "citable": false,
        "decl_name": "mem_of_fatten_of_fst_eq",
        "depth": 6,
        "dictionary_leaves": [
          "fatten"
        ],
        "hypotheses": [
          {
            "name": "hu",
            "pretty": "u ∈ fatten✝ E"
