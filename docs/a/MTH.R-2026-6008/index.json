        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {J P : Type u} [inst : LinearOrder J] {E : Set J} {j j' e : J},\n  e ∈ E → j < e → e < j' → padGround✝ E ∩ Sum.inl '' {a | a < j} ≠ padGround✝ E ∩ Sum.inl '' {a | a < j'}",
        "topo": 6,
