        "doc": "A point of `E` strictly between `j` and `j'` separates the two traces: it lies in the trace\nat `j'` and, being above `j`, not in the trace at `j`.",
        "hypotheses": [
          {
            "name": "heE",
            "pretty": "e ∈ E"
          },
          {
            "name": "hje",
            "pretty": "j < e"
          },
