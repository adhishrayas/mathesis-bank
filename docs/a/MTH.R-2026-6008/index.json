          "dedSet'"
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ (κ : Cardinal.{u}), 1 ∈ dedSet'✝ κ",
        "topo": 1,
        "type_sha256": "265556936c786242753b053aed02f77375df6e8fe19699a62f6cfc042ae2331c"
      },
