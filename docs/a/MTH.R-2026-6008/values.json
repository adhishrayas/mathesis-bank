    "field": "argument_node.doc",
    "value": "A point of E strictly between j and j' separates the two traces: it lies in the trace at j' and, being above j, not in the trace at j."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {J P : Type u} [inst : LinearOrder J] {E : Set J} {j j' e : J},\n  e ∈ E → j < e → e < j' → padGround✝ E ∩ Sum.inl '' {a | a < j} ≠ padGround✝ E ∩ Sum.inl '' {a | a < j'}"
  },
