    "nodes": [
      {
        "citable": true,
        "decl_name": "encard_image_inter_le_encard_shatters",
        "depth": 0,
        "dictionary_leaves": [
          "Shatters"
        ],
        "doc": "**Pajor's inequality**, with no finiteness assumptions: the traces of `𝒜` on `A` are at most\nas many as the subsets of `A` shattered by `𝒜`. For a finite trace family this is a descent on\nthe number of traces that never consumes the ground set; an infinite trace family forces\ninfinitely many shattered singletons, and both sides are `⊤`.\n\nDvir, Filmus and Moran, *A Sauer-Shelah-Perles Lemma for Lattices*, credit the Boolean\nlattice case to Pajor (*Sous-espaces `ℓ₁ⁿ` des espaces de Banach*, Travaux en Cours 16,\nHermann, Paris, 1985) and to Aharoni and Holzman, unpublished. Their Theorem 1.2 is the\nlattice form, for finite lattices with nonvanishing Möbius function: a family shatters at\nleast as many elements as it has members. Reading that for a family of traces on a ground\nset is the standard translation into the language of set families, and the statement here\ncarries no finiteness hypothesis, which theirs does.",
        "is_root": true,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α}, ((fun x => A ∩ x) '' 𝒜).encard ≤ {B | B ⊆ A ∧ Shatters 𝒜 B}.encard",
        "topo": 0,
        "type_sha256": "3cdd55e82875f6a90abe9ace7c3141acc05e28c021e23cf60ff49d29bc235859"
      },
      {
        "citable": false,
        "decl_name": "pajor_encard_aux",
        "depth": 1,
        "dictionary_leaves": [
          "Shatters",
          "Shatters.mono",
          "shatters_bot"
        ],
        "hypotheses": [
          {
            "name": "a",
            "pretty": "((fun x => A ∩ x) '' 𝒜).Finite"
          },
          {
            "name": "a",
            "pretty": "((fun x => A ∩ x) '' 𝒜).ncard ≤ N"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {A : Set α} (N : ℕ) (𝒜 : Set (Set α)),\n  ((fun x => A ∩ x) '' 𝒜).Finite →\n    ((fun x => A ∩ x) '' 𝒜).ncard ≤ N → ((fun x => A ∩ x) '' 𝒜).encard ≤ {B | B ⊆ A ∧ Shatters 𝒜 B}.encard",
        "topo": 1,
        "type_sha256": "d06096c13ea0bb1be8c522633bee77338e1039d7d6b23e5dfbb6567978093c4e"
      },
      {
        "citable": false,
        "decl_name": "trace_sep_union",
        "depth": 2,
        "dictionary_leaves": [],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α} {x : α},\n  (fun x => A ∩ x) '' {C | C ∈ 𝒜 ∧ x ∉ C} ∪ (fun x => A ∩ x) '' {C | C ∈ 𝒜 ∧ x ∈ C} = (fun x => A ∩ x) '' 𝒜",
        "topo": 2,
        "type_sha256": "75117f3fb72607fc5d187967cdd57cce008ef5acdf01bda15cd5514e786dd8fb"
      },
      {
        "citable": false,
        "decl_name": "trace_sep_disjoint",
        "depth": 2,
        "dictionary_leaves": [],
        "hypotheses": [
          {
            "name": "hxA",
            "pretty": "x ∈ A"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α} {x : α},\n  x ∈ A → Disjoint ((fun x => A ∩ x) '' {C | C ∈ 𝒜 ∧ x ∉ C}) ((fun x => A ∩ x) '' {C | C ∈ 𝒜 ∧ x ∈ C})",
        "topo": 3,
        "type_sha256": "a35f853da08102fd045e134530fe94d7346d2bbab5b2d16ff7b17a8090982ce7"
      },
      {
        "citable": false,
        "decl_name": "notMem_of_shatters_sep_right",
        "depth": 2,
        "dictionary_leaves": [
          "Shatters",
          "Shatters.preimage_compl"
        ],
        "hypotheses": [
          {
            "name": "h",
            "pretty": "Shatters {C | C ∈ 𝒜 ∧ x ∈ C} B"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {B : Set α} {x : α}, Shatters {C | C ∈ 𝒜 ∧ x ∈ C} B → x ∉ B",
        "topo": 4,
        "type_sha256": "3789081f0f7c1c35c39e9188b4ed5bf4f0cefdfc4ee6c6c833d0e3b808d74447"
      },
      {
        "citable": false,
        "decl_name": "notMem_of_shatters_sep_left",
        "depth": 2,
        "dictionary_leaves": [
          "Shatters"
        ],
        "hypotheses": [
          {
            "name": "h",
            "pretty": "Shatters {C | C ∈ 𝒜 ∧ x ∉ C} B"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {B : Set α} {x : α}, Shatters {C | C ∈ 𝒜 ∧ x ∉ C} B → x ∉ B",
        "topo": 5,
        "type_sha256": "88194a6ba106f21354a533f4e9c9407c72c81e8cbff5c75872ce341f759bd2ca"
      },
      {
        "citable": false,
        "decl_name": "notMem_of_forall_notMem",
        "depth": 3,
        "dictionary_leaves": [
          "Shatters",
          "Shatters.exists_ge"
        ],
        "doc": "A family whose members all avoid `x` shatters only sets avoiding `x`.",
        "hypotheses": [
          {
            "name": "h𝒜",
            "pretty": "∀ C ∈ 𝒜, x ∉ C"
          },
          {
            "name": "hB",
            "pretty": "Shatters 𝒜 B"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {B : Set α} {x : α}, (∀ C ∈ 𝒜, x ∉ C) → Shatters 𝒜 B → x ∉ B",
        "topo": 6,
        "type_sha256": "0a89bd943b1677673d2db3904eaf34824a227ca23d5ad89c6f74b04b178874e7"
      },
      {
        "citable": false,
        "decl_name": "insert_injOn_notMem",
        "depth": 2,
        "dictionary_leaves": [],
        "doc": "Inserting a fixed element is injective on the sets avoiding it: the element can be removed\nagain, recovering the argument.",
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} (x : α), Set.InjOn (insert x) {B | x ∉ B}",
        "topo": 7,
        "type_sha256": "b2b630597e87b3aa8c5a6a08c7cc3f1b731cf5c07269bd280771327d1d539fbb"
      },
      {
        "citable": false,
        "decl_name": "exists_splitter",
        "depth": 2,
        "dictionary_leaves": [],
        "hypotheses": [
          {
            "name": "h",
            "pretty": "((fun x => A ∩ x) '' 𝒜).Nontrivial"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α},\n  ((fun x => A ∩ x) '' 𝒜).Nontrivial → ∃ x ∈ A, (∃ C ∈ 𝒜, x ∈ C) ∧ ∃ C ∈ 𝒜, x ∉ C",
        "topo": 8,
        "type_sha256": "bf128b9ae6e42421468be1de4c47974493ab34a4df400255fa46cd873680099a"
      },
      {
        "citable": false,
        "decl_name": "exists_splitter_of_not_subset",
        "depth": 3,
        "dictionary_leaves": [],
        "doc": "A point of `A` witnessing that one trace fails to contain another is a point at which `𝒜`\nsplits.",
        "hypotheses": [
          {
            "name": "hC",
            "pretty": "C ∈ 𝒜"
          },
          {
            "name": "hC'",
            "pretty": "C' ∈ 𝒜"
          },
          {
            "name": "h",
            "pretty": "¬A ∩ C ⊆ A ∩ C'"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A C C' : Set α},\n  C ∈ 𝒜 → C' ∈ 𝒜 → ¬A ∩ C ⊆ A ∩ C' → ∃ x ∈ A, (∃ D ∈ 𝒜, x ∈ D) ∧ ∃ D ∈ 𝒜, x ∉ D",
        "topo": 9,
        "type_sha256": "db76368f8fa8e4773199534767058383ba18d4192d44d14118accf802ebf00f6"
      },
      {
        "citable": false,
        "decl_name": "disjoint_image_insert",
        "depth": 2,
        "dictionary_leaves": [],
        "doc": "A family whose members all avoid `x` is disjoint from any family of sets containing `x`.",
        "hypotheses": [
          {
            "name": "h𝒮",
            "pretty": "∀ B ∈ 𝒮, x ∉ B"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {x : α} {𝒮 𝒯 : Set (Set α)}, (∀ B ∈ 𝒮, x ∉ B) → Disjoint 𝒮 (insert x '' 𝒯)",
        "topo": 10,
        "type_sha256": "4d3f54756b3b15242c1216f9b37781d7f52dede3f0062e32bae5c671d1751102"
      },
      {
        "citable": true,
        "decl_name": "Shatters.insert",
        "depth": 2,
        "dictionary_leaves": [
          "Shatters"
        ],
        "doc": "If `B` is shattered both by the members of `𝒜` avoiding `x` and by the members of `𝒜`\ncontaining `x`, then `𝒜` shatters `insert x B`. This is the exchange step in the proof of\nPajor's inequality.",
        "hypotheses": [
          {
            "name": "h₀",
            "pretty": "Shatters {C | C ∈ 𝒜 ∧ x ∉ C} B"
          },
          {
            "name": "h₁",
            "pretty": "Shatters {C | C ∈ 𝒜 ∧ x ∈ C} B"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {B : Set α} {x : α},\n  Shatters {C | C ∈ 𝒜 ∧ x ∉ C} B → Shatters {C | C ∈ 𝒜 ∧ x ∈ C} B → Shatters 𝒜 (insert x B)",
        "topo": 11,
        "type_sha256": "401f0506870bd69e6d357c3cd0d657b783e64d214834032417427ce4b41d4d7f"
      },
      {
        "citable": true,
        "decl_name": "infinite_setOf_shatters",
        "depth": 1,
        "dictionary_leaves": [
          "Shatters",
          "splitPoints"
        ],
        "hypotheses": [
          {
            "name": "h",
            "pretty": "((fun x => A ∩ x) '' 𝒜).Infinite"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α}, ((fun x => A ∩ x) '' 𝒜).Infinite → {B | B ⊆ A ∧ Shatters 𝒜 B}.Infinite",
        "topo": 12,
        "type_sha256": "a8f0a1f0677ffa65048f23a336815f7841f9792c50e87817b7a3a61a25ba07e0"
      },
      {
        "citable": false,
        "decl_name": "singleton_image_splitPoints_subset",
        "depth": 2,
        "dictionary_leaves": [
          "Shatters",
          "splitPoints"
        ],
        "doc": "The singleton of a point at which `𝒜` splits is shattered by `𝒜`.",
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α}, (fun x => {x}) '' splitPoints✝ 𝒜 A ⊆ {B | B ⊆ A ∧ Shatters 𝒜 B}",
        "topo": 13,
        "type_sha256": "34be113f8b8d7fb954dfdfdb273bf6eb177e8acd07aa961c13701b124df00c28"
      },
      {
        "citable": true,
        "decl_name": "shatters_singleton",
        "depth": 3,
        "dictionary_leaves": [
          "Shatters"
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {x : α}, Shatters 𝒜 {x} ↔ (∃ C ∈ 𝒜, x ∈ C) ∧ ∃ C ∈ 𝒜, x ∉ C",
        "topo": 14,
        "type_sha256": "49f83bc12d8704c3518f41a47136a3bd9b62f67ffb83b49aee2bd7d54406cc87"
      },
      {
        "citable": true,
        "decl_name": "Shatters.of_forall_subset",
        "depth": 4,
        "dictionary_leaves": [
          "Shatters"
        ],
        "doc": "`Shatters` read at `Set α`, as an introduction rule; the `∩`-shaped companion of\n`Shatters.of_forall_le`.",
        "hypotheses": [
          {
            "name": "h",
            "pretty": "∀ ⦃B : Set α⦄, B ⊆ A → ∃ C ∈ 𝒜, A ∩ C = B"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α}, (∀ ⦃B : Set α⦄, B ⊆ A → ∃ C ∈ 𝒜, A ∩ C = B) → Shatters 𝒜 A",
        "topo": 15,
        "type_sha256": "8c5b8cc4ee2ba20223898f9552071b6e167fe58e276b007f72724df6fa6ef6ca"
      },
      {
        "citable": true,
        "decl_name": "Shatters.exists_inter_eq",
        "depth": 4,
        "dictionary_leaves": [
          "Shatters"
        ],
        "doc": "`Shatters` read at `Set α`, where `⊓` is `∩` and `≤` is `⊆`: every subset of `A` is the\nintersection of `A` with a member of `𝒜`. Definitionally the same statement, stated in the\nshape every use site wants, so that consumers obtain an `∩`-typed equation directly.",
        "hypotheses": [
          {
            "name": "h",
            "pretty": "Shatters 𝒜 A"
          },
          {
            "name": "hB",
            "pretty": "B ⊆ A"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A B : Set α}, Shatters 𝒜 A → B ⊆ A → ∃ C ∈ 𝒜, A ∩ C = B",
        "topo": 16,
        "type_sha256": "1bebaf911524687843be8f681ce03cb0a85d61b6fe13aa65ee349d470b477b0c"
      },
      {
        "citable": false,
        "decl_name": "finite_image_inter_of_finite_splitPoints",
        "depth": 2,
        "dictionary_leaves": [
          "splitPoints"
        ],
        "doc": "A family splitting `A` at finitely many elements has finitely many traces on `A`.",
        "hypotheses": [
          {
            "name": "h",
            "pretty": "(splitPoints✝ 𝒜 A).Finite"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α}, (splitPoints✝ 𝒜 A).Finite → ((fun x => A ∩ x) '' 𝒜).Finite",
        "topo": 17,
        "type_sha256": "655c42d84356a56134664c07865e77670d49e07485b4fc81af59b7b97ceef7a9"
      },
      {
        "citable": false,
        "decl_name": "injOn_inter_splitPoints",
        "depth": 3,
        "dictionary_leaves": [
          "splitPoints"
        ],
        "doc": "A trace of `𝒜` on `A` is determined by its restriction to the elements at which `𝒜`\nsplits: elsewhere, membership in the trace is decided by `A` alone.",
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α}, Set.InjOn (fun x => x ∩ splitPoints✝ 𝒜 A) ((fun x => A ∩ x) '' 𝒜)",
        "topo": 18,
        "type_sha256": "7c48b7e83714d0b40558d0de2a5c3d847b0aafaa31501fa1a2a55063fb1fce86"
      }
    ]
