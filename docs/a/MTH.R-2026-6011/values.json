  {
    "field": "argument_node.doc",
    "value": "SOA mistakes from a given state are bounded by the Ldim of the version space. This is the core M-Potential argument."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {X : Type} {C : ConceptClass X Bool},\n  ∀ c ∈ C,\n    ∀ (history : List (X × Bool)),\n      (∀ p ∈ history, c p.1 = p.2) →\n        ∀ (d : ℕ),\n          LittlestoneDim X (versionSpace C history) ≤ ↑↑d →\n            LittlestoneDim X (versionSpace C history) < ⊤ → ∀ (seq : List X), (SOA X C).mistakesFrom history c seq ≤ d"
  },
