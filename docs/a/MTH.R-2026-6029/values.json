    "field": "argument_node.pretty",
    "value": "∀ {X : Type u} [inst : MeasurableSpace X] {A : Type u_1} [inst_1 : Fintype A] (D : MeasureTheory.Measure X)\n  [MeasureTheory.IsProbabilityMeasure D] (c : Concept X Bool),\n  Measurable c →\n    ∀ (cand : A → Concept X Bool),\n      (∀ (a : A), Measurable (cand a)) →\n        ∀ (m : ℕ),\n          0 < m →\n            ∀ (η : ℝ),\n              0 < η →\n                η ≤ 1 →\n                  (MeasureTheory.Measure.pi fun x => D)\n                      {xs |\n                        ∃ a,\n                          |TrueErrorReal X (cand a) c D -\n                                EmpiricalError X Bool (cand a) (fun i => (xs i, c (xs i))) (zeroOneLoss Bool)| ≥\n                            η} ≤\n                    ENNReal.ofReal (↑(Fintype.card A) * 2 * Real.exp (-2 * ↑m * η ^ 2))"
  },
