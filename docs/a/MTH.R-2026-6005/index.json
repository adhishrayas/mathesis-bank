      {
        "citable": true,
        "decl_name": "pairShatters_graft",
        "depth": 4,
        "dictionary_leaves": [
          "PairShatters",
          "graft",
          "pairSupport"
        ],
        "doc": "**The graft.** A pattern pair-shattered by the branch at `a` and by the branch at `b`\nextends by one unconstrained point carrying the pair `{a, b}` there to a pattern pair-shattered\nby the whole family. The selection at the new point names the branch that realises it. This is\nthe multiclass exchange step, and it mirrors `Shatters.insert`.\n\nThe two labels are not required to differ. Distinctness is what makes the result a pair\npattern, and it enters at `mem_pairCubes_graft_pairOf`, not here.",
        "hypotheses": [
          {
            "name": "hPx",
            "pretty": "P x = ∅"
          },
          {
            "name": "ha",
            "pretty": "PairShatters {c | c ∈ 𝒞 ∧ c x = a} P"
          },
          {
            "name": "hb",
            "pretty": "PairShatters {c | c ∈ 𝒞 ∧ c x = b} P"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {X : Type u_1} {Y : Type u_2} {𝒞 : Set (X → Y)} {P : X → Set Y} {x : X} {a b : Y},\n  P x = ∅ →\n    PairShatters {c | c ∈ 𝒞 ∧ c x = a} P → PairShatters {c | c ∈ 𝒞 ∧ c x = b} P → PairShatters 𝒞 (graft P x {a, b})",
        "topo": 12,
        "type_sha256": "f9e1c133b463d7464cbb836337b78f7dd9e9fe1240cde8aa7d0c4f2e918a66d0"
      },
      {
        "citable": true,
        "decl_name": "pairSupport_graft",
        "depth": 5,
        "dictionary_leaves": [
          "graft",
          "pairSupport"
        ],
        "hypotheses": [
          {
            "name": "hs",
            "pretty": "s.Nonempty"
          }
        ],
