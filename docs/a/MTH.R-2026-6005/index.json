        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {X : Type u_1} {Y : Type u_2} {𝒞 : Set (X → Y)} {S : Set X} {x : X} {u : Y},\n  x ∈ S →\n    ∀ {c : X → Y},\n      c ∈ 𝒞 → c x ≠ u → (S.restrict '' 𝒞).Finite → (S.restrict '' {d | d ∈ 𝒞 ∧ d x = u}).ncard < (S.restrict '' 𝒞).ncard",
        "topo": 8,
        "type_sha256": "9a5f3a15d05382f49aa0d09e41e2639b3c93f146f16c531a7d64425630690a3d"
      },
