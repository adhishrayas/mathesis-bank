        "pretty": "∀ {Y : Type u_2} (u : Y), Function.Injective (pairOf✝ u)",
        "topo": 7,
        "type_sha256": "f4c95f482c99b454b6696fe24c2e050d0bc538be9092069550c50231480986a6"
