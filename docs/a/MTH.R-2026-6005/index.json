      {
        "citable": false,
        "decl_name": "exists_injOn_pairCubes",
        "depth": 1,
        "dictionary_leaves": [
          "IsPairPattern",
          "PairShatters",
          "graft",
          "pairCubes",
          "pairOf",
          "pairSupport"
        ],
        "doc": "The whole accounting, as one injection from traces to cubes.\n\nAt a point where two traces differ, every realised value gets its own branch, and a trace is\nrouted by the value it takes there. The branch injections supplied by the induction hypothesis\nland in cubes that avoid that point, and a cube pair-shattered by `μ` branches carries `μ`\ntraces into `μ` of the `1 + μ.choose 2` cubes available above it: the cube itself for the\nbranch selected as the anchor, and one graft for each of the other `μ - 1`. Injectivity is read\noff the graft, since `pairOf u ·` is injective and the pattern below the new point is recovered\nby evaluating away from it.",
        "hypotheses": [
          {
            "name": "a",
            "pretty": "(S.restrict '' 𝒞).Finite"
          },
          {
            "name": "a",
            "pretty": "(S.restrict '' 𝒞).ncard ≤ N"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {X : Type u_1} {Y : Type u_2} (S : Set X) (N : ℕ) (𝒞 : Set (X → Y)),\n  (S.restrict '' 𝒞).Finite →\n    (S.restrict '' 𝒞).ncard ≤ N → ∃ φ, Set.MapsTo φ (S.restrict '' 𝒞) (pairCubes 𝒞 S) ∧ Set.InjOn φ (S.restrict '' 𝒞)",
        "topo": 6,
        "type_sha256": "357514dff916f255ebb47a731d93927b5d7d04b97c88ecf377cc689688867e0c"
      },
