        "kind": "theorem",
        "pretty": "∀ {X : Type u_1} {Y : Type u_2} (P : X → Set Y) (x : X) {s : Set Y},\n  s.Nonempty → pairSupport (graft P x s) = insert x (pairSupport P)",
        "topo": 13,
        "type_sha256": "fe249c7c9fc60f3d1b2c5964cb7b863ee211652b12218bbde6734c6530ac7e4a"
