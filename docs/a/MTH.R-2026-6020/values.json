  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {ι : Type u_1} [inst : DecidableEq ι] {𝒞 : Finset (Finset ι)} {S Sep : Finset ι} {a b x : ι},\n  x ≠ a →\n    (∀ (u : ι),\n        u ∈ S \\ Sep ∧ HiddenChannelCapacity.ReachOn 𝒞 (fun v => v ∈ S \\ Sep) a u → ¬HiddenChannelCapacity.Adj 𝒞 x u) →\n      ¬HiddenChannelCapacity.ReachOn 𝒞 (fun v => v ∈ S \\ Sep) a b →\n        ¬HiddenChannelCapacity.ReachOn 𝒞 (fun v => v ∈ S \\ Sep.erase x) a b"
  },
