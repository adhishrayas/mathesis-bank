  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "Dudley's bound. The VC dimension of the linear sign class of a finite-dimensional subspace V ≤ (X → ℝ) is at most dim V."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {X : Type u} (V : Submodule ℝ (X → ℝ)) [FiniteDimensional ℝ ↥V], VCDim X (signClass V) ≤ ↑(Module.finrank ℝ ↥V)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "ConceptClass"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Concept"
  },
  {
    "field": "dictionary_constant.name",
    "value": "Shatters"
