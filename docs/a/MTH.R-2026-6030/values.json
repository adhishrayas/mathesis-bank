  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "The coordinate space is finite-dimensional (it is the span of a finite family)."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (n : ℕ), FiniteDimensional ℝ ↥(FLT.Halfspace.coordSpace n)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Halfspace.coord"
  },
  {
