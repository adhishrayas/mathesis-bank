  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "The dimension of the coordinate space is n. The coordinate functionals form the dual basis of ℝⁿ, so their span has dimension n."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (n : ℕ), Module.finrank ℝ ↥(FLT.Halfspace.coordSpace n) = n"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Halfspace.coord"
