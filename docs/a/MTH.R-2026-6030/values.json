    "field": "argument_node.decl_name",
    "value": "FLT.Halfspace.linearIndependent_coord"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "The coordinate functionals are linearly independent. They are the dual basis of the standard basis; concretely, evaluating a vanishing combination at each standard basis point Pi.single j 1 isolates the j-th coefficient."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (n : ℕ), LinearIndependent ℝ (FLT.Halfspace.coord n)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Halfspace.coord"
  },
  {
    "field": "argument_node.decl_name",
    "value": "FLT.Halfspace.coord_single"
  },
  {
    "field": "argument_node.decl_name",
    "value": "FLT.Halfspace.finrank_coordSpace"
  },
  {
    "field": "argument_node.decl_name",
    "value": "FLT.Halfspace.coord_single"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "Evaluating the i-th coordinate functional at the j-th standard basis point gives the identity matrix: coord n i (Pi.single j 1) = if i = j then 1 else 0."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (n : ℕ) (i j : Fin n), FLT.Halfspace.coord n i (Pi.single j 1) = if i = j then 1 else 0"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Halfspace.coord"
  },
  {
    "field": "argument_node.decl_name",
    "value": "FLT.Halfspace.linearIndependent_coord"
  },
