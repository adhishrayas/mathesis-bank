  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "Each standard basis point lies in basisPoints n."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (n : ℕ) (i : Fin n), Pi.single i 1 ∈ FLT.Halfspace.basisPoints n"
  },
  {
