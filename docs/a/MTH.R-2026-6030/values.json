  {
    "field": "dictionary_constant.name",
    "value": "ConceptClass"
  },
  {
    "field": "dictionary_constant.kind",
    "value": "def"
  },
  {
    "field": "dictionary_constant.doc",
    "value": "A concept class is a set of concepts. Used by every paradigm, complexity measure, and criterion.Primary definition: Set of functions. Used for PAC/agnostic PAC where concept classes are sets over which VC dimension, Rademacher complexity, covering numbers, etc. are measured. Alternative definitions below for contexts requiring decidability, enumerability, or measurability."
  },
  {
    "field": "dictionary_constant.pretty",
    "value": "Type u → Type v → Type (max v u)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Concept"
  },
  {
    "field": "dictionary_constant.kind",
    "value": "def"
  },
  {
    "field": "dictionary_constant.doc",
    "value": "A concept is a function from domain to label. This is the atomic unit that concept classes collect and learners try to approximate."
  },
  {
    "field": "dictionary_constant.pretty",
    "value": "Type u → Type v → Type (max u v)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Halfspace.basisPoints"
  },
  {
    "field": "dictionary_constant.kind",
    "value": "def"
  },
  {
    "field": "dictionary_constant.doc",
    "value": "The n standard basis points {Pi.single i 1 | i : Fin n} of ℝⁿ. These are the witnesses for the VC-dimension lower bound."
  },
  {
    "field": "dictionary_constant.pretty",
    "value": "(n : ℕ) → Finset (Fin n → ℝ)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Halfspace.coord"
  },
  {
    "field": "dictionary_constant.kind",
    "value": "def"
  },
  {
    "field": "dictionary_constant.doc",
    "value": "The i-th coordinate functional x ↦ x i on Fin n → ℝ, viewed as an element of the function space (Fin n → ℝ) → ℝ."
  },
  {
    "field": "dictionary_constant.pretty",
    "value": "(n : ℕ) → Fin n → (Fin n → ℝ) → ℝ"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Halfspace.coordSpace"
  },
  {
    "field": "dictionary_constant.kind",
    "value": "def"
  },
  {
    "field": "dictionary_constant.doc",
    "value": "The coordinate space: the span of the n coordinate functionals (fun x => x i) inside (Fin n → ℝ) → ℝ. This is the (dual) space of homogeneous linear functionals on ℝⁿ; its sign class is exactly the family of homogeneous linear halfspaces."
  },
  {
    "field": "dictionary_constant.pretty",
    "value": "(n : ℕ) → Submodule ℝ ((Fin n → ℝ) → ℝ)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "Shatters"
  },
  {
    "field": "dictionary_constant.kind",
    "value": "def"
  },
  {
    "field": "argument.cites",
    "value": "Yaël Dillies"
  },
  {
    "field": "dictionary_constant.doc",
    "value": "A set S ⊆ X is shattered by concept class C if every labeling of S is realized by some concept in C."
  },
  {
    "field": "dictionary_constant.pretty",
    "value": "(X : Type u) → ConceptClass X Bool → Finset X → Prop"
  },
  {
    "field": "dictionary_constant.name",
