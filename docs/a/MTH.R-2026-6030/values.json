  },
  {
    "field": "argument_node.doc",
    "value": "VC dimension of homogeneous linear halfspaces: the lower bound. The n standard basis points are shattered, so the VC dimension is at least n."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (n : ℕ), ↑n ≤ VCDim (Fin n → ℝ) (signClass (FLT.Halfspace.coordSpace n))"
  },
