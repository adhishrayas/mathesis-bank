  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "There are exactly n standard basis points."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (n : ℕ), (FLT.Halfspace.basisPoints n).card = n"
  },
  {
