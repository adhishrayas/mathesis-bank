    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "A weighted functional evaluated at a standard basis point returns that point's weight: (∑ i, w i * (Pi.single j 1) i) = w j."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (n : ℕ) (w : Fin n → ℝ) (j : Fin n), ∑ i, w i * Pi.single j 1 i = w j"
  },
  {
    "field": "argument_node.decl_name",
    "value": "FLT.Halfspace.shatters_basisPoints"
  },
  {
    "field": "argument_node.decl_name",
    "value": "FLT.Halfspace.weighted_mem_coordSpace"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "A ±1-weighted coordinate functional belongs to the coordinate space. Concretely, for any weights w : Fin n → ℝ, the functional x ↦ ∑ i, w i * x i is a member of coordSpace n."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (n : ℕ) (w : Fin n → ℝ), (fun x => ∑ i, w i * x i) ∈ FLT.Halfspace.coordSpace n"
  },
  {
    "field": "dictionary_constant.name",
    "value": "FLT.Halfspace.coord"
  },
  {
    "field": "dictionary_constant.name",
