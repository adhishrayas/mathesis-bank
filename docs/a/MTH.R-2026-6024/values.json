    "value": "InformationTheory.binary_pinsker"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.deriv_g_nonneg_of_ge"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "On [p, 1): derivative of g is nonnegative."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (p q : ℝ), p ≤ q → 0 < q → q < 1 → 0 ≤ (q - p) * (1 - 2 * q) ^ 2 / (q * (1 - q))"
  },
  {
