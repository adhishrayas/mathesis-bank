    "value": "InformationTheory.klBin_zero_left"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.monotoneOn_g"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.two_sq_le_neg_log"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.two_sq_le_neg_log_one_sub"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.two_sq_sub_le_klDivReal"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.two_sq_le_neg_log"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "2 (1 - q)² ≤ -log q for q ∈ (0, 1]. Substitute r = 1 - q into the previous."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (q : ℝ), 0 < q → q ≤ 1 → 2 * (1 - q) ^ 2 ≤ -Real.log q"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.two_sq_le_neg_log_one_sub"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.binary_pinsker"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.two_sq_le_neg_log_one_sub"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "2 q² ≤ -log(1 - q) for q ∈ [0, 1)."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (q : ℝ), 0 ≤ q → q < 1 → 2 * q ^ 2 ≤ -Real.log (1 - q)"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.monotoneOn_h_zero"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.binary_pinsker"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.two_sq_le_neg_log"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.monotoneOn_h_zero"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "h(q) = -log(1-q) - 2 q² is monotone on [0, 1)."
  },
  {
    "field": "argument_node.pretty",
    "value": "MonotoneOn (fun q => -Real.log (1 - q) - 2 * q ^ 2) (Set.Ico 0 1)"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.hasDerivAt_h_zero"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.two_sq_le_neg_log_one_sub"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.hasDerivAt_h_zero"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "Derivative of h(q) = -log(1-q) - 2 q² at q < 1."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ q < 1, HasDerivAt (fun q => -Real.log (1 - q) - 2 * q ^ 2) ((2 * q - 1) ^ 2 / (1 - q)) q"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.monotoneOn_h_zero"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.monotoneOn_g"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "g(q) = klBin p q − 2 (p − q)² is monotone on [p, 1)."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (p : ℝ), 0 < p → p < 1 → MonotoneOn (fun q => InformationTheory.klBin p q - 2 * (p - q) ^ 2) (Set.Ico p 1)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "InformationTheory.klBin"
  },
  {
    "field": "argument_node.decl_name",
    "value": "InformationTheory.continuousOn_g_Ico"
  },
