    "nodes": [
      {
        "citable": true,
        "decl_name": "InformationTheory.pinsker_proof",
        "depth": 0,
        "dictionary_leaves": [
          "InformationTheory.klDivReal",
          "MeasureTheory.tvDistReal"
        ],
        "doc": "**Pinsker's inequality** with the sharp constant.\n`tvDistReal P Q ≤ sqrt(klDivReal P Q / 2)` for probability measures `P ≪ Q` with\nfinite KL divergence.",
        "hypotheses": [
          {
            "name": "hac",
            "pretty": "P.AbsolutelyContinuous Q"
          },
          {
            "name": "h_int",
            "pretty": "MeasureTheory.Integrable (MeasureTheory.llr P Q) P"
          }
        ],
        "is_root": true,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α)\n  [inst_1 : MeasureTheory.IsProbabilityMeasure P] [inst_2 : MeasureTheory.IsProbabilityMeasure Q],\n  P.AbsolutelyContinuous Q →\n    MeasureTheory.Integrable (MeasureTheory.llr P Q) P →\n      MeasureTheory.tvDistReal P Q ≤ √(InformationTheory.klDivReal P Q / 2)",
        "topo": 0,
        "type_sha256": "19e1fb4bee5ea3a5172137dae67e191623820544fcb9669b80a3ba7d4a91dd16"
      },
      {
        "citable": true,
        "decl_name": "MeasureTheory.tvDistReal_set_nonempty",
        "depth": 1,
        "dictionary_leaves": [],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsFiniteMeasure P]\n  [MeasureTheory.IsFiniteMeasure Q], {x | ∃ A, MeasurableSet A ∧ x = |(P A).toReal - (Q A).toReal|}.Nonempty",
        "topo": 1,
        "type_sha256": "6080fbd36323d6d98541687b85511eabb1e22fc5ac38863c053416c1ea5b8403"
      },
      {
        "citable": true,
        "decl_name": "InformationTheory.two_sq_sub_le_klDivReal",
        "depth": 1,
        "dictionary_leaves": [
          "InformationTheory.klBin",
          "InformationTheory.klDivReal"
        ],
        "doc": "**Per-set squared bound.** `2 (P(A) − Q(A))² ≤ klDivReal P Q` for any measurable\nset `A`, given `P ≪ Q` and finite KL.",
        "hypotheses": [
          {
            "name": "hac",
            "pretty": "P.AbsolutelyContinuous Q"
          },
          {
            "name": "h_int",
            "pretty": "MeasureTheory.Integrable (MeasureTheory.llr P Q) P"
          },
          {
            "name": "hA",
            "pretty": "MeasurableSet A"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsProbabilityMeasure P]\n  [MeasureTheory.IsProbabilityMeasure Q],\n  P.AbsolutelyContinuous Q →\n    MeasureTheory.Integrable (MeasureTheory.llr P Q) P →\n      ∀ (A : Set α), MeasurableSet A → 2 * (P.real A - Q.real A) ^ 2 ≤ InformationTheory.klDivReal P Q",
        "topo": 2,
        "type_sha256": "585df9f56e1f171be10d222baa3d7476cf9f38551d06a64776ea94602adf698b"
      },
      {
        "citable": true,
        "decl_name": "InformationTheory.klBin_le_klDivReal",
        "depth": 2,
        "dictionary_leaves": [
          "InformationTheory.klBin",
          "InformationTheory.klDivReal"
        ],
        "doc": "**Data processing inequality for indicators.** For probability measures `P ≪ Q`\nwith finite KL divergence and any measurable set `A`, the binary KL between the\nmarginals on `(A, Aᶜ)` is bounded by the full KL:\n`klBin(P(A), Q(A)) ≤ klDivReal P Q`.",
        "hypotheses": [
          {
            "name": "hac",
            "pretty": "P.AbsolutelyContinuous Q"
          },
          {
            "name": "h_int",
            "pretty": "MeasureTheory.Integrable (MeasureTheory.llr P Q) P"
          },
          {
            "name": "hA",
            "pretty": "MeasurableSet A"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsProbabilityMeasure P]\n  [MeasureTheory.IsProbabilityMeasure Q],\n  P.AbsolutelyContinuous Q →\n    MeasureTheory.Integrable (MeasureTheory.llr P Q) P →\n      ∀ (A : Set α), MeasurableSet A → InformationTheory.klBin (P.real A) (Q.real A) ≤ InformationTheory.klDivReal P Q",
        "topo": 3,
        "type_sha256": "ad90ca1bbaf7e7c100f8e597263b2ff25666001d78aa6b7e9bc5e5a26171d40b"
      },
      {
        "citable": true,
        "decl_name": "InformationTheory.klFun_integral_ge_of_measurableSet",
        "depth": 3,
        "dictionary_leaves": [],
        "doc": "**Jensen on a subset.** For a finite measure `Q` and a measurable set `A` with\npositive mass, if `f` and `klFun ∘ f` are integrable and `f ≥ 0` almost everywhere,\nthen `Q(A) · klFun((1/Q(A)) · ∫_A f dQ) ≤ ∫_A klFun(f) dQ`.",
        "hypotheses": [
          {
            "name": "hf_int",
            "pretty": "MeasureTheory.Integrable f Q"
          },
          {
            "name": "hf_int_kl",
            "pretty": "MeasureTheory.Integrable (fun x => InformationTheory.klFun (f x)) Q"
          },
          {
            "name": "hf_nn",
            "pretty": "∀ᵐ (x : α) ∂Q, 0 ≤ f x"
          },
          {
            "name": "hQA_pos",
            "pretty": "0 < Q.real A"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} [inst : MeasurableSpace α] {Q : MeasureTheory.Measure α} [MeasureTheory.IsFiniteMeasure Q] (f : α → ℝ),\n  MeasureTheory.Integrable f Q →\n    MeasureTheory.Integrable (fun x => InformationTheory.klFun (f x)) Q →\n      (∀ᵐ (x : α) ∂Q, 0 ≤ f x) →\n        ∀ {A : Set α},\n          0 < Q.real A →\n            Q.real A * InformationTheory.klFun ((Q.real A)⁻¹ * ∫ (x : α) in A, f x ∂Q) ≤\n              ∫ (x : α) in A, InformationTheory.klFun (f x) ∂Q",
        "topo": 4,
        "type_sha256": "ad82bf0063ac8aada876dcce98ffad61f1f1464ae2cdfa729fd9df59d86cf5fa"
      },
      {
        "citable": true,
        "decl_name": "InformationTheory.klBin_eq_klFun_sum",
        "depth": 3,
        "dictionary_leaves": [
          "InformationTheory.klBin"
        ],
        "doc": "**Algebraic identity.** The binary KL factors through `klFun`:\n`klBin p q = q · klFun(p/q) + (1 − q) · klFun((1 − p)/(1 − q))`.",
        "hypotheses": [
          {
            "name": "hq₀",
            "pretty": "0 < q"
          },
          {
            "name": "hq₁",
            "pretty": "q < 1"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ (p q : ℝ),\n  0 < q →\n    q < 1 →\n      InformationTheory.klBin p q =\n        q * InformationTheory.klFun (p / q) + (1 - q) * InformationTheory.klFun ((1 - p) / (1 - q))",
        "topo": 5,
        "type_sha256": "82cc618557a2deb66e2999bc3a5d6a6c21188eccf5dd3e49d76f23e8825a78cd"
      },
      {
        "citable": true,
        "decl_name": "InformationTheory.binary_pinsker",
        "depth": 2,
        "dictionary_leaves": [
          "InformationTheory.klBin"
        ],
        "doc": "**Binary Pinsker inequality.** `2 (p − q)² ≤ klBin p q` for `p ∈ [0, 1]`,\n`q ∈ (0, 1)`. Sharp constant `2`.",
        "hypotheses": [
          {
            "name": "hp₀",
            "pretty": "0 ≤ p"
          },
          {
            "name": "hp₁",
            "pretty": "p ≤ 1"
          },
          {
            "name": "hq₀",
            "pretty": "0 < q"
          },
          {
            "name": "hq₁",
            "pretty": "q < 1"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ (p q : ℝ), 0 ≤ p → p ≤ 1 → 0 < q → q < 1 → 2 * (p - q) ^ 2 ≤ InformationTheory.klBin p q",
        "topo": 6,
        "type_sha256": "3989ea2b9f2e008150465e67b5f0380614d43216af9f59e35e451452a93463fe"
      },
      {
        "citable": true,
        "decl_name": "InformationTheory.two_sq_le_neg_log",
        "depth": 3,
        "dictionary_leaves": [],
        "doc": "`2 (1 - q)² ≤ -log q` for `q ∈ (0, 1]`. Substitute `r = 1 - q` into the previous.",
        "hypotheses": [
          {
            "name": "hq₀",
            "pretty": "0 < q"
          },
          {
            "name": "hq₁",
            "pretty": "q ≤ 1"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ (q : ℝ), 0 < q → q ≤ 1 → 2 * (1 - q) ^ 2 ≤ -Real.log q",
        "topo": 7,
        "type_sha256": "1438dbf743a240974fca6de59ec1aae07ecd716b59336a07265db39a9ef4de3d"
      },
      {
        "citable": true,
        "decl_name": "InformationTheory.two_sq_le_neg_log_one_sub",
        "depth": 4,
        "dictionary_leaves": [],
        "doc": "`2 q² ≤ -log(1 - q)` for `q ∈ [0, 1)`.",
        "hypotheses": [
          {
            "name": "hq₀",
            "pretty": "0 ≤ q"
          },
          {
            "name": "hq₁",
            "pretty": "q < 1"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ (q : ℝ), 0 ≤ q → q < 1 → 2 * q ^ 2 ≤ -Real.log (1 - q)",
        "topo": 8,
        "type_sha256": "2b3a4012ec6faad3d245451b4e6a244101427e8f24bceb0528d8b34b726297bf"
      },
      {
        "citable": false,
        "decl_name": "InformationTheory.monotoneOn_h_zero",
        "depth": 5,
        "dictionary_leaves": [],
        "doc": "`h(q) = -log(1-q) - 2 q²` is monotone on `[0, 1)`.",
        "is_root": false,
        "kind": "theorem",
        "pretty": "MonotoneOn (fun q => -Real.log (1 - q) - 2 * q ^ 2) (Set.Ico 0 1)",
        "topo": 9,
        "type_sha256": "2bf6530004e5e48c05c0dbcae845c3ae30dcafdc23e0621e00a10d3e23c4874a"
      },
      {
        "citable": false,
        "decl_name": "InformationTheory.hasDerivAt_h_zero",
        "depth": 6,
        "dictionary_leaves": [],
        "doc": "Derivative of `h(q) = -log(1-q) - 2 q²` at `q < 1`.",
        "hypotheses": [
          {
            "name": "hq₁",
            "pretty": "q < 1"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ q < 1, HasDerivAt (fun q => -Real.log (1 - q) - 2 * q ^ 2) ((2 * q - 1) ^ 2 / (1 - q)) q",
        "topo": 10,
        "type_sha256": "7d1daced2f3527a27c052a3a4d2187323e71980835238f5f12a4b86f2d34c8ab"
      },
      {
        "citable": true,
        "decl_name": "InformationTheory.monotoneOn_g",
        "depth": 3,
        "dictionary_leaves": [
          "InformationTheory.klBin"
        ],
        "doc": "`g(q) = klBin p q − 2 (p − q)²` is monotone on `[p, 1)`.",
        "hypotheses": [
          {
            "name": "hp₀",
            "pretty": "0 < p"
          },
          {
            "name": "hp₁",
            "pretty": "p < 1"
          }
