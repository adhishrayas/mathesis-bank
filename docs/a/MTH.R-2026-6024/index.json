        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ (p : ℝ), 0 < p → p < 1 → MonotoneOn (fun q => InformationTheory.klBin p q - 2 * (p - q) ^ 2) (Set.Ico p 1)",
        "topo": 11,
        "type_sha256": "4698c9a5ba9610f412bf38eda847b08fa25431c9d9fedee1a313e774bdca196b"
      },
      {
        "citable": true,
        "decl_name": "InformationTheory.deriv_g_nonneg_of_ge",
        "depth": 4,
        "dictionary_leaves": [],
        "doc": "On `[p, 1)`: derivative of `g` is nonnegative.",
        "hypotheses": [
          {
            "name": "hpq",
            "pretty": "p ≤ q"
          },
          {
            "name": "hq₀",
            "pretty": "0 < q"
          },
          {
            "name": "hq₁",
