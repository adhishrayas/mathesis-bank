  },
  {
    "field": "argument_node.doc",
    "value": "The anchor leg of the intersection convention: a maximum of the label set in the membership order is a size-1 kernel. The upper inclusion comes from the realizing member, the lower from maximality."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} [inst : DecidableEq α] {𝒜 : Set (Set α)} {A T : Finset α},\n  StructuralIgnorance.IsSample 𝒜 A T →\n    ∀ {x : α},\n      x ∈ T →\n        (∀ a ∈ T, StructuralIgnorance.memOrder 𝒜 a x) →\n          StructuralIgnorance.IsKernel (StructuralIgnorance.interConvention 𝒜) 1 A T {x}"
  },
