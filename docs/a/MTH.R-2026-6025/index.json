          {
            "name": "h",
            "pretty": "StructuralIgnorance.vcBounded 𝒜 1"
          },
          {
            "name": "hemp",
            "pretty": "∅ ∈ 𝒜"
          },
          {
            "name": "hab",
            "pretty": "∃ S ∈ 𝒜, a ∈ S ∧ b ∈ S"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} [DecidableEq α] {𝒜 : Set (Set α)},\n  StructuralIgnorance.vcBounded 𝒜 1 →\n    ∅ ∈ 𝒜 →\n      ∀ {a b : α}, (∃ S ∈ 𝒜, a ∈ S ∧ b ∈ S) → StructuralIgnorance.memOrder 𝒜 a b ∨ StructuralIgnorance.memOrder 𝒜 b a",
