    "nodes": [
      {
        "citable": true,
        "decl_name": "StructuralIgnorance.hasKernelScheme_one_of_vcBounded_one",
        "depth": 0,
        "dictionary_leaves": [
          "StructuralIgnorance.Convention",
          "StructuralIgnorance.HasKernelScheme",
          "StructuralIgnorance.IsKernel",
          "StructuralIgnorance.IsSample",
          "StructuralIgnorance.interConvention",
          "StructuralIgnorance.memOrder",
          "StructuralIgnorance.twistClass",
          "StructuralIgnorance.vcBounded"
        ],
        "doc": "**d = 1 universality: every VC-1 class compresses at kernel size one, with\nno side information.** No finiteness, no distinguished member, no chain\nhypothesis. Twist the class by any member to place `∅` in it; there the VC\nbound makes co-member points comparable in the membership order, so every label\nset is a finite chain; anchor at its maximum, reconstruct with\n`interConvention`, and transport the scheme back with the same kernels.",
        "hypotheses": [
          {
            "name": "h",
            "pretty": "StructuralIgnorance.vcBounded 𝒜 1"
          }
        ],
        "is_root": true,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} [inst : DecidableEq α] {𝒜 : Set (Set α)},\n  StructuralIgnorance.vcBounded 𝒜 1 → StructuralIgnorance.HasKernelScheme 𝒜 1",
        "topo": 0,
        "type_sha256": "6f00e0db8508b3920cb330e210ef6ed0976367e4600819d7a085d3a13863b980"
      },
      {
        "citable": true,
        "decl_name": "StructuralIgnorance.vcBounded_twistClass",
        "depth": 1,
        "dictionary_leaves": [
          "StructuralIgnorance.SetShatters",
          "StructuralIgnorance.twistClass",
          "StructuralIgnorance.vcBounded"
        ],
        "doc": "VC bounds are twist-invariant (the direction needed for normalization).",
        "hypotheses": [
          {
            "name": "h",
            "pretty": "StructuralIgnorance.vcBounded 𝒜 d"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} [DecidableEq α] {𝒜 : Set (Set α)} {d : ℕ},\n  StructuralIgnorance.vcBounded 𝒜 d →\n    ∀ (S₀ : Set α), StructuralIgnorance.vcBounded (StructuralIgnorance.twistClass 𝒜 S₀) d",
        "topo": 1,
        "type_sha256": "59e8e78dd7f571645accf7bb7c222f8e4ed8f4c316bd6858cfd0464008797edf"
      },
      {
        "citable": true,
