        "dictionary_leaves": [
          "StructuralIgnorance.SetShatters",
          "StructuralIgnorance.baseLabels",
          "StructuralIgnorance.twistClass"
        ],
        "doc": "Shattering transports from the twisted class back to the original: the\nwitnesses untwist, and the patterns correspond through the involution\n`C ↦ C ∆ (B ∩ S₀)`.",
        "hypotheses": [
          {
            "name": "h",
            "pretty": "StructuralIgnorance.SetShatters (StructuralIgnorance.twistClass 𝒜 S₀) B"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} [DecidableEq α] {𝒜 : Set (Set α)} {S₀ : Set α} {B : Finset α},\n  StructuralIgnorance.SetShatters (StructuralIgnorance.twistClass 𝒜 S₀) B → StructuralIgnorance.SetShatters 𝒜 B",
        "topo": 2,
        "type_sha256": "a3c23978923592508890c30578881f68bd8610fd7f0b5ab988f665e0ca68008e"
      },
      {
        "citable": true,
        "decl_name": "StructuralIgnorance.memOrder_total_of_vcBounded_one",
