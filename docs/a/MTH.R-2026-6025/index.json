        "pretty": "∀ {α : Type u_1} [inst : DecidableEq α] {𝒜 : Set (Set α)} {A T : Finset α},\n  StructuralIgnorance.IsSample 𝒜 A T →\n    ∀ {x : α},\n      x ∈ T →\n        (∀ a ∈ T, StructuralIgnorance.memOrder 𝒜 a x) →\n          StructuralIgnorance.IsKernel (StructuralIgnorance.interConvention 𝒜) 1 A T {x}",
        "topo": 4,
