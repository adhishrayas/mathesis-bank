  {
    "field": "argument_node.pretty",
    "value": "∀ {X : Type u} [inst : MeasurableSpace X] (D : MeasureTheory.Measure X) [MeasureTheory.IsProbabilityMeasure D] {k : ℕ},\n  0 < k →\n    ∀ (c : Concept X Bool),\n      Measurable c →\n        ∀ (hs : Fin k → Concept X Bool),\n          (∀ (j : Fin k), Measurable (hs j)) →\n            ∀ (good : Finset (Fin k)),\n              7 * k ≤ 12 * good.card →\n                ∀ (ρ : ℝ),\n                  0 ≤ ρ →\n                    (∀ j ∈ good, D {x | hs j x ≠ c x} ≤ ENNReal.ofReal ρ) →\n                      D {x | (boosted_majority✝ k fun j => hs j x) ≠ c x} ≤ ENNReal.ofReal (7 * ρ)"
  },
