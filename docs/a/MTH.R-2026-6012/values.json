  {
    "field": "argument_node.pretty",
    "value": "∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsProbabilityMeasure μ] {k : ℕ}\n  {δ : ℝ},\n  0 < δ →\n    36 / δ ≤ ↑k →\n      ∀ (events : Fin k → Set Ω),\n        (∀ (j : Fin k), MeasurableSet (events j)) →\n          ProbabilityTheory.iIndepSet (fun j => events j) μ →\n            (∀ (j : Fin k), μ (events j) ≥ ENNReal.ofReal (2 / 3)) →\n              μ {ω | 7 * k ≤ 12 * {j | ω ∈ events j}.card} ≥ ENNReal.ofReal (1 - δ)"
  },
  {
    "field": "argument_node.decl_name",
    "value": "boost_two_thirds_to_pac"
  },
  {
    "field": "argument_node.decl_name",
