        ],
        "doc": "On an SOA mistake, the Ldim of the version space strictly decreases.",
        "hypotheses": [
          {
            "name": "hc_vs",
            "pretty": "c ∈ versionSpace C history"
          },
          {
            "name": "hpred",
            "pretty": "(SOA X C).predict history x ≠ c x"
          },
          {
            "name": "hfin",
            "pretty": "LittlestoneDim X (versionSpace C history) < ⊤"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {X : Type} {C : ConceptClass X Bool} {history : List (X × Bool)} {x : X} {c : X → Bool},\n  c ∈ versionSpace C history →\n    (SOA X C).predict history x ≠ c x →\n      LittlestoneDim X (versionSpace C history) < ⊤ →\n        LittlestoneDim X (versionSpace C (history ++ [(x, c x)])) < LittlestoneDim X (versionSpace C history)",
        "topo": 7,
        "type_sha256": "7a5a0caf264bd0ab9405ebcb5e68ee3d52a52043e955970ee71a89de53721261"
      },
      {
