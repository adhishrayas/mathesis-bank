        "decl_name": "ldim_branch_lower_bound",
        "depth": 4,
        "dictionary_leaves": [
          "ConceptClass",
          "FLT.Concept",
          "LTree",
          "LTree.isShattered",
          "LittlestoneDim"
        ],
        "doc": "Build a tree of depth k+1 from shattered subtrees on both sides.\nParametrized over b : Bool so we don't need to case-split in the caller.",
        "hypotheses": [
          {
            "name": "hb",
            "pretty": "∃ Tb, LTree.isShattered {c | c ∈ V ∧ c x = b} Tb"
          },
          {
            "name": "hnb",
            "pretty": "∃ Tnb, LTree.isShattered {c | c ∈ V ∧ c x = !b} Tnb"
          },
          {
            "name": "hwb",
            "pretty": "∃ c ∈ V, c x = b"
          },
          {
            "name": "hwnb",
            "pretty": "∃ c ∈ V, c x = !b"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {X : Type} {V : ConceptClass X Bool} {x : X} {k : ℕ} {b : Bool},\n  (∃ Tb, LTree.isShattered {c | c ∈ V ∧ c x = b} Tb) →\n    (∃ Tnb, LTree.isShattered {c | c ∈ V ∧ c x = !b} Tnb) →\n      (∃ c ∈ V, c x = b) → (∃ c ∈ V, c x = !b) → LittlestoneDim X V ≥ ↑↑(k + 1)",
        "topo": 10,
        "type_sha256": "34c34dd74fc09b2e8ada4cfa90db859d1ecd0bd607a550606057fcf4dc8c8627"
      },
