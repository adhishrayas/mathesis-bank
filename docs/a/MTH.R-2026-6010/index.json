        ],
        "doc": "SOA mistakes from a given state are bounded by the Ldim of the version space.\nThis is the core M-Potential argument.",
        "hypotheses": [
          {
            "name": "hcC",
            "pretty": "c ∈ C"
          },
          {
            "name": "hcons",
            "pretty": "∀ p ∈ history, c p.1 = p.2"
          },
          {
            "name": "hd",
            "pretty": "LittlestoneDim X (versionSpace C history) ≤ ↑↑d"
          },
          {
            "name": "hfin",
            "pretty": "LittlestoneDim X (versionSpace C history) < ⊤"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {X : Type} {C : ConceptClass X Bool},\n  ∀ c ∈ C,\n    ∀ (history : List (X × Bool)),\n      (∀ p ∈ history, c p.1 = p.2) →\n        ∀ (d : ℕ),\n          LittlestoneDim X (versionSpace C history) ≤ ↑↑d →\n            LittlestoneDim X (versionSpace C history) < ⊤ → ∀ (seq : List X), (SOA X C).mistakesFrom history c seq ≤ d",
        "topo": 4,
        "type_sha256": "14e1feb61f565d93fec2b3b520dbbe63543a72eee8d3bf529ea28c9ac5683aef"
      },
