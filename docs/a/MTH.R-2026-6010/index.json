        "doc": "When Ldim(V) = 0 (↑↑0), all concepts in V agree on every point.\nKey lemma for M-VersionSpaceCollapse.",
        "hypotheses": [
          {
            "name": "hd",
            "pretty": "LittlestoneDim X V = ↑0"
          },
          {
            "name": "_hne",
            "pretty": "Set.Nonempty V"
          },
          {
            "name": "hc₁",
            "pretty": "c₁ ∈ V"
          },
          {
            "name": "hc₂",
            "pretty": "c₂ ∈ V"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {X : Type} {V : ConceptClass X Bool},\n  LittlestoneDim X V = ↑0 → Set.Nonempty V → ∀ (x : X) (c₁ c₂ : X → Bool), c₁ ∈ V → c₂ ∈ V → c₁ x = c₂ x",
        "topo": 9,
