    "nodes": [
      {
        "citable": true,
        "decl_name": "HasVCDimLE.vcGrowth_le_exp",
        "depth": 0,
        "dictionary_leaves": [
          "HasVCDimLE",
          "vcGrowth"
        ],
        "hypotheses": [
          {
            "name": "h𝒜",
            "pretty": "HasVCDimLE d 𝒜"
          },
          {
            "name": "hdn",
            "pretty": "d ≤ n"
          }
        ],
        "is_root": true,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {n d : ℕ} {𝒜 : Set (Set α)}, HasVCDimLE d 𝒜 → d ≤ n → ↑(vcGrowth n 𝒜) ≤ (Real.exp 1 / ↑d * ↑n) ^ d",
        "topo": 0,
        "type_sha256": "a5fe126e5cef7d4b177045266b5d2d950687516c61088d45ac2d9984d1771d44"
      },
      {
        "citable": false,
        "decl_name": "sum_choose_le_exp_pow",
        "depth": 1,
        "dictionary_leaves": [],
        "hypotheses": [
          {
            "name": "hd",
            "pretty": "0 < d"
          },
          {
            "name": "hdm",
            "pretty": "d ≤ m"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ (d m : ℕ), 0 < d → d ≤ m → ∑ i ∈ Finset.range (d + 1), ↑(m.choose i) ≤ (Real.exp 1 / ↑d * ↑m) ^ d",
        "topo": 1,
        "type_sha256": "556ba84807bf0da6c1b0fb1693d6e9471052f75639af790e19f5d4b6c2801d7f"
      },
      {
        "citable": false,
        "decl_name": "sum_choose_mul_pow_le_add_one_pow",
        "depth": 2,
        "dictionary_leaves": [],
        "doc": "Truncating a binomial expansion at degree `d` can only decrease it, for `t ≥ 0`.",
        "hypotheses": [
          {
            "name": "ht",
            "pretty": "0 ≤ t"
          },
          {
            "name": "hdm",
            "pretty": "d ≤ m"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {m d : ℕ} {t : ℝ}, 0 ≤ t → d ≤ m → ∑ i ∈ Finset.range (d + 1), ↑(m.choose i) * t ^ i ≤ (1 + t) ^ m",
        "topo": 2,
        "type_sha256": "8f6784dfeb2425d47375330ccc3de29847a6b93453cf99a5db52c9c4bfb45bfa"
      },
      {
        "citable": false,
        "decl_name": "sum_choose_le_mul_sum_choose_mul_pow",
        "depth": 2,
        "dictionary_leaves": [],
        "doc": "Undoing the weighting `t ^ i` costs a single factor `(m / d) ^ d`, since `t = d / m` and\neach `i` in range is at most `d`.",
        "hypotheses": [
          {
            "name": "hd",
            "pretty": "0 < ↑d"
          },
          {
            "name": "hm",
            "pretty": "0 < ↑m"
          },
          {
            "name": "hdm",
            "pretty": "↑d ≤ ↑m"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {m d : ℕ},\n  0 < ↑d →\n    0 < ↑m →\n      ↑d ≤ ↑m →\n        ∑ i ∈ Finset.range (d + 1), ↑(m.choose i) ≤\n          (↑m / ↑d) ^ d * ∑ i ∈ Finset.range (d + 1), ↑(m.choose i) * (↑d / ↑m) ^ i",
        "topo": 3,
        "type_sha256": "063ac17fe94ae8fa4aae3e187a5a401c63ab2b3571422936b7d69b3b3bd313c5"
      },
      {
        "citable": false,
        "decl_name": "one_add_div_pow_le_exp_pow",
        "depth": 2,
        "dictionary_leaves": [],
        "doc": "At `t = d / m`, the binomial base is bounded by `exp 1` raised to the degree.",
        "hypotheses": [
          {
            "name": "hm",
            "pretty": "0 < ↑m"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {m d : ℕ}, 0 < ↑m → (1 + ↑d / ↑m) ^ m ≤ Real.exp 1 ^ d",
        "topo": 4,
        "type_sha256": "8a064e826e4594ca86eee1077847e1b33866258ee00832db15cad3c3ae33ed00"
      },
      {
        "citable": true,
        "decl_name": "HasVCDimLE.vcGrowth_le_sum_range",
        "depth": 1,
        "dictionary_leaves": [
          "HasVCDimLE",
          "vcGrowth"
        ],
        "doc": "**The Sauer-Shelah inequality**, with the sum indexed by `Finset.range (d + 1)`.",
        "hypotheses": [
          {
            "name": "h𝒜",
            "pretty": "HasVCDimLE d 𝒜"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {n d : ℕ} {𝒜 : Set (Set α)}, HasVCDimLE d 𝒜 → vcGrowth n 𝒜 ≤ ∑ k ∈ Finset.range (d + 1), n.choose k",
        "topo": 5,
        "type_sha256": "bd0ab963ec9fa29566f97f15331552e50f65aad79091d26560b5980495296d18"
      },
      {
        "citable": true,
        "decl_name": "HasVCDimLE.vcGrowth_le",
        "depth": 2,
        "dictionary_leaves": [
          "HasVCDimLE",
          "vcGrowth",
          "vcGrowth_le_iff"
        ],
        "hypotheses": [
          {
            "name": "h𝒜",
            "pretty": "HasVCDimLE d 𝒜"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {n d : ℕ} {𝒜 : Set (Set α)}, HasVCDimLE d 𝒜 → vcGrowth n 𝒜 ≤ ∑ k ∈ Finset.Iic d, n.choose k",
        "topo": 6,
        "type_sha256": "9288533c64ccf1616e0c6c70e8d6771883add756410d1031f27f69ed44bde298"
      },
      {
        "citable": true,
        "decl_name": "HasVCDimLE.ncard_image_inter_le",
        "depth": 3,
        "dictionary_leaves": [
          "HasVCDimLE",
          "Shatters"
        ],
        "doc": "**The Sauer-Shelah inequality**: a family of VC dimension at most `d` traces at most\n`∑ k ≤ d, n.choose k` sets on any finite set of size at most `n`. The proof here derives it\nfrom Pajor's inequality.\n\nSimon, *A Guide to NIP Theories*, states the same bound as his Lemma 6.4, for the growth\nfunction of a class of VC dimension at most `k`, and records in the notes to that chapter\nthat the lemma is implicit in Vapnik and Chervonenkis (1971) and was rediscovered\nindependently by Shelah (1972) and by Sauer (1972). Dvir, Filmus and Moran state it in the\nintroduction to *A Sauer-Shelah-Perles Lemma for Lattices* and cite the same three sources.\nPerles is carried in the name they give the lemma; a publication of his is cited by neither\nsource.",
        "hypotheses": [
          {
            "name": "h𝒜",
            "pretty": "HasVCDimLE d 𝒜"
          },
          {
            "name": "hA",
            "pretty": "A.Finite"
          },
          {
            "name": "hAn",
            "pretty": "A.ncard ≤ n"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {n d : ℕ} {𝒜 : Set (Set α)} {A : Set α},\n  HasVCDimLE d 𝒜 → A.Finite → A.ncard ≤ n → ((fun x => A ∩ x) '' 𝒜).ncard ≤ ∑ k ∈ Finset.Iic d, n.choose k",
        "topo": 7,
        "type_sha256": "65c52353910d3fdf909cabc2402c1c68af46a8f2aa05b0efb4679b2b8df1897e"
      },
      {
        "citable": false,
        "decl_name": "ncard_setOf_ncard_le",
        "depth": 4,
        "dictionary_leaves": [],
        "hypotheses": [
          {
            "name": "hA",
            "pretty": "A.Finite"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {A : Set α},\n  A.Finite → ∀ (d : ℕ), {B | B ⊆ A ∧ B.ncard ≤ d}.ncard = ∑ k ∈ Finset.Iic d, A.ncard.choose k",
        "topo": 8,
        "type_sha256": "a926554442694cd2ae815562fdc5d16811649986439df49adda6e9eded0a597b"
      },
      {
        "citable": false,
        "decl_name": "setOf_subset_and_ncard_le_zero",
        "depth": 5,
        "dictionary_leaves": [],
        "hypotheses": [
          {
            "name": "hA",
            "pretty": "A.Finite"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {A : Set α}, A.Finite → {B | B ⊆ A ∧ B.ncard ≤ 0} = {∅}",
        "topo": 9,
        "type_sha256": "363368c63ae4721d209f15f2b89352c2859843e7f5aacbeb6e9cf9172c053684"
      },
      {
        "citable": false,
        "decl_name": "setOf_subset_and_ncard_le_succ",
        "depth": 5,
        "dictionary_leaves": [],
        "doc": "The subsets of `A` of size at most `d + 1` split into those of size at most `d` and those of\nsize exactly `d + 1`.",
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} (d : ℕ) (A : Set α),\n  {B | B ⊆ A ∧ B.ncard ≤ d + 1} = {B | B ⊆ A ∧ B.ncard ≤ d} ∪ {B | B ⊆ A ∧ B.ncard = d + 1}",
        "topo": 10,
        "type_sha256": "53a9364771bc84c8951b64d6e3b362f86ad1be5c17c2398c2a1d178625a75269"
      },
      {
        "citable": false,
        "decl_name": "disjoint_setOf_ncard_le_setOf_ncard_eq",
        "depth": 5,
        "dictionary_leaves": [],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} (d : ℕ) (A : Set α), Disjoint {B | B ⊆ A ∧ B.ncard ≤ d} {B | B ⊆ A ∧ B.ncard = d + 1}",
        "topo": 11,
        "type_sha256": "5fe2cd64ae7a4f16bbab6afdce02d23c20228ad8e2724bd14d543fe039eef73b"
      },
      {
        "citable": false,
        "decl_name": "ncard_image_inter_le_ncard_setOf_shatters",
        "depth": 4,
        "dictionary_leaves": [
          "Shatters"
        ],
        "doc": "The `ncard` transfer of `encard_image_inter_le_encard_shatters`, for `A` finite. Internal:\nthe general statement is the `encard` one, which needs no hypothesis.",
        "hypotheses": [
          {
            "name": "hA",
            "pretty": "A.Finite"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α},\n  A.Finite → ((fun x => A ∩ x) '' 𝒜).ncard ≤ {B | B ⊆ A ∧ Shatters 𝒜 B}.ncard",
        "topo": 12,
        "type_sha256": "c0a8fa32c7c91ad35c63afc08b0a73e9c09109c3f080608bed03f987079d01be"
      },
      {
        "citable": true,
        "decl_name": "encard_image_inter_le_encard_shatters",
        "depth": 5,
        "dictionary_leaves": [
          "Shatters"
        ],
        "doc": "**Pajor's inequality**, with no finiteness assumptions: the traces of `𝒜` on `A` are at most\nas many as the subsets of `A` shattered by `𝒜`. For a finite trace family this is a descent on\nthe number of traces that never consumes the ground set; an infinite trace family forces\ninfinitely many shattered singletons, and both sides are `⊤`.\n\nDvir, Filmus and Moran, *A Sauer-Shelah-Perles Lemma for Lattices*, credit the Boolean\nlattice case to Pajor (*Sous-espaces `ℓ₁ⁿ` des espaces de Banach*, Travaux en Cours 16,\nHermann, Paris, 1985) and to Aharoni and Holzman, unpublished. Their Theorem 1.2 is the\nlattice form, for finite lattices with nonvanishing Möbius function: a family shatters at\nleast as many elements as it has members. Reading that for a family of traces on a ground\nset is the standard translation into the language of set families, and the statement here\ncarries no finiteness hypothesis, which theirs does.",
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α}, ((fun x => A ∩ x) '' 𝒜).encard ≤ {B | B ⊆ A ∧ Shatters 𝒜 B}.encard",
        "topo": 13,
        "type_sha256": "3cdd55e82875f6a90abe9ace7c3141acc05e28c021e23cf60ff49d29bc235859"
      },
      {
        "citable": false,
        "decl_name": "pajor_encard_aux",
        "depth": 6,
        "dictionary_leaves": [
          "Shatters",
          "Shatters.mono",
          "shatters_bot"
        ],
        "hypotheses": [
          {
            "name": "a",
            "pretty": "((fun x => A ∩ x) '' 𝒜).Finite"
          },
          {
            "name": "a",
            "pretty": "((fun x => A ∩ x) '' 𝒜).ncard ≤ N"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {A : Set α} (N : ℕ) (𝒜 : Set (Set α)),\n  ((fun x => A ∩ x) '' 𝒜).Finite →\n    ((fun x => A ∩ x) '' 𝒜).ncard ≤ N → ((fun x => A ∩ x) '' 𝒜).encard ≤ {B | B ⊆ A ∧ Shatters 𝒜 B}.encard",
        "topo": 14,
        "type_sha256": "d06096c13ea0bb1be8c522633bee77338e1039d7d6b23e5dfbb6567978093c4e"
      },
      {
        "citable": false,
        "decl_name": "trace_sep_union",
        "depth": 7,
        "dictionary_leaves": [],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α} {x : α},\n  (fun x => A ∩ x) '' {C | C ∈ 𝒜 ∧ x ∉ C} ∪ (fun x => A ∩ x) '' {C | C ∈ 𝒜 ∧ x ∈ C} = (fun x => A ∩ x) '' 𝒜",
        "topo": 15,
        "type_sha256": "75117f3fb72607fc5d187967cdd57cce008ef5acdf01bda15cd5514e786dd8fb"
      },
      {
        "citable": false,
        "decl_name": "trace_sep_disjoint",
        "depth": 7,
        "dictionary_leaves": [],
        "hypotheses": [
          {
            "name": "hxA",
            "pretty": "x ∈ A"
          }
        ],
        "is_root": false,
        "kind": "theorem",
        "pretty": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α} {x : α},\n  x ∈ A → Disjoint ((fun x => A ∩ x) '' {C | C ∈ 𝒜 ∧ x ∉ C}) ((fun x => A ∩ x) '' {C | C ∈ 𝒜 ∧ x ∈ C})",
        "topo": 16,
        "type_sha256": "a35f853da08102fd045e134530fe94d7346d2bbab5b2d16ff7b17a8090982ce7"
      },
      {
        "citable": false,
        "decl_name": "notMem_of_shatters_sep_right",
