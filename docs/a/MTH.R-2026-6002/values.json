    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} {n d : ℕ} {𝒜 : Set (Set α)}, HasVCDimLE d 𝒜 → d ≤ n → ↑(vcGrowth n 𝒜) ≤ (Real.exp 1 / ↑d * ↑n) ^ d"
  },
  {
    "field": "dictionary_constant.name",
    "value": "HasVCDimLE"
  },
  {
    "field": "dictionary_constant.name",
    "value": "vcGrowth"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.vcGrowth_le_sum_range"
  },
  {
    "field": "argument_node.decl_name",
    "value": "sum_choose_le_exp_pow"
  },
  {
    "field": "argument_node.decl_name",
    "value": "sum_choose_le_exp_pow"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (d m : ℕ), 0 < d → d ≤ m → ∑ i ∈ Finset.range (d + 1), ↑(m.choose i) ≤ (Real.exp 1 / ↑d * ↑m) ^ d"
  },
  {
    "field": "argument_node.decl_name",
    "value": "one_add_div_pow_le_exp_pow"
  },
  {
    "field": "argument_node.decl_name",
    "value": "sum_choose_le_mul_sum_choose_mul_pow"
  },
  {
    "field": "argument_node.decl_name",
    "value": "sum_choose_mul_pow_le_add_one_pow"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.vcGrowth_le_exp"
  },
  {
    "field": "argument_node.decl_name",
    "value": "sum_choose_mul_pow_le_add_one_pow"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "Truncating a binomial expansion at degree d can only decrease it, for t ≥ 0."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {m d : ℕ} {t : ℝ}, 0 ≤ t → d ≤ m → ∑ i ∈ Finset.range (d + 1), ↑(m.choose i) * t ^ i ≤ (1 + t) ^ m"
  },
  {
    "field": "argument_node.decl_name",
    "value": "sum_choose_le_exp_pow"
  },
  {
    "field": "argument_node.decl_name",
    "value": "sum_choose_le_mul_sum_choose_mul_pow"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "Undoing the weighting t ^ i costs a single factor (m / d) ^ d, since t = d / m and each i in range is at most d."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {m d : ℕ},\n  0 < ↑d →\n    0 < ↑m →\n      ↑d ≤ ↑m →\n        ∑ i ∈ Finset.range (d + 1), ↑(m.choose i) ≤\n          (↑m / ↑d) ^ d * ∑ i ∈ Finset.range (d + 1), ↑(m.choose i) * (↑d / ↑m) ^ i"
  },
  {
    "field": "argument_node.decl_name",
    "value": "sum_choose_le_exp_pow"
  },
  {
    "field": "argument_node.decl_name",
    "value": "one_add_div_pow_le_exp_pow"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "At t = d / m, the binomial base is bounded by exp 1 raised to the degree."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {m d : ℕ}, 0 < ↑m → (1 + ↑d / ↑m) ^ m ≤ Real.exp 1 ^ d"
  },
  {
    "field": "argument_node.decl_name",
    "value": "sum_choose_le_exp_pow"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.vcGrowth_le_sum_range"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "The Sauer-Shelah inequality, with the sum indexed by Finset.range (d + 1)."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} {n d : ℕ} {𝒜 : Set (Set α)}, HasVCDimLE d 𝒜 → vcGrowth n 𝒜 ≤ ∑ k ∈ Finset.range (d + 1), n.choose k"
  },
  {
    "field": "dictionary_constant.name",
    "value": "HasVCDimLE"
  },
  {
    "field": "dictionary_constant.name",
    "value": "vcGrowth"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.vcGrowth_le"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.vcGrowth_le_exp"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.vcGrowth_le"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} {n d : ℕ} {𝒜 : Set (Set α)}, HasVCDimLE d 𝒜 → vcGrowth n 𝒜 ≤ ∑ k ∈ Finset.Iic d, n.choose k"
  },
  {
    "field": "dictionary_constant.name",
    "value": "HasVCDimLE"
  },
  {
    "field": "dictionary_constant.name",
    "value": "vcGrowth"
  },
  {
    "field": "dictionary_constant.name",
    "value": "vcGrowth_le_iff"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.ncard_image_inter_le"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.vcGrowth_le_sum_range"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.ncard_image_inter_le"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "The Sauer-Shelah inequality: a family of VC dimension at most d traces at most ∑ k ≤ d, n.choose k sets on any finite set of size at most n. The proof here derives it from Pajor's inequality.Simon, A Guide to NIP Theories, states the same bound as his Lemma 6.4, for the growth function of a class of VC dimension at most k, and records in the notes to that chapter that the lemma is implicit in Vapnik and Chervonenkis (1971) and was rediscovered independently by Shelah (1972) and by Sauer (1972). Dvir, Filmus and Moran state it in the introduction to A Sauer-Shelah-Perles Lemma for Lattices and cite the same three sources. Perles is carried in the name they give the lemma; a publication of his is cited by neither source."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} {n d : ℕ} {𝒜 : Set (Set α)} {A : Set α},\n  HasVCDimLE d 𝒜 → A.Finite → A.ncard ≤ n → ((fun x => A ∩ x) '' 𝒜).ncard ≤ ∑ k ∈ Finset.Iic d, n.choose k"
  },
  {
    "field": "dictionary_constant.name",
    "value": "HasVCDimLE"
  },
  {
    "field": "dictionary_constant.name",
    "value": "Shatters"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.ncard_le_of_shatters"
  },
  {
    "field": "argument_node.decl_name",
    "value": "finite_setOf_subset_and"
  },
  {
    "field": "argument_node.decl_name",
    "value": "ncard_image_inter_le_ncard_setOf_shatters"
  },
  {
    "field": "argument_node.decl_name",
    "value": "ncard_setOf_ncard_le"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.vcGrowth_le"
  },
  {
    "field": "argument_node.decl_name",
    "value": "ncard_setOf_ncard_le"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} {A : Set α},\n  A.Finite → ∀ (d : ℕ), {B | B ⊆ A ∧ B.ncard ≤ d}.ncard = ∑ k ∈ Finset.Iic d, A.ncard.choose k"
  },
  {
    "field": "argument_node.decl_name",
    "value": "disjoint_setOf_ncard_le_setOf_ncard_eq"
  },
  {
    "field": "argument_node.decl_name",
    "value": "finite_setOf_subset_and"
  },
  {
    "field": "argument_node.decl_name",
    "value": "setOf_subset_and_ncard_le_succ"
  },
  {
    "field": "argument_node.decl_name",
    "value": "setOf_subset_and_ncard_le_zero"
  },
  {
    "field": "argument_node.decl_name",
    "value": "HasVCDimLE.ncard_image_inter_le"
  },
  {
    "field": "argument_node.decl_name",
    "value": "setOf_subset_and_ncard_le_zero"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} {A : Set α}, A.Finite → {B | B ⊆ A ∧ B.ncard ≤ 0} = {∅}"
  },
  {
    "field": "argument_node.decl_name",
    "value": "ncard_setOf_ncard_le"
  },
  {
    "field": "argument_node.decl_name",
    "value": "setOf_subset_and_ncard_le_succ"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "The subsets of A of size at most d + 1 split into those of size at most d and those of size exactly d + 1."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} (d : ℕ) (A : Set α),\n  {B | B ⊆ A ∧ B.ncard ≤ d + 1} = {B | B ⊆ A ∧ B.ncard ≤ d} ∪ {B | B ⊆ A ∧ B.ncard = d + 1}"
  },
  {
    "field": "argument_node.decl_name",
    "value": "ncard_setOf_ncard_le"
  },
  {
    "field": "argument_node.decl_name",
    "value": "disjoint_setOf_ncard_le_setOf_ncard_eq"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} (d : ℕ) (A : Set α), Disjoint {B | B ⊆ A ∧ B.ncard ≤ d} {B | B ⊆ A ∧ B.ncard = d + 1}"
  },
  {
    "field": "argument_node.decl_name",
    "value": "ncard_setOf_ncard_le"
  },
  {
    "field": "argument_node.decl_name",
    "value": "ncard_image_inter_le_ncard_setOf_shatters"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.doc",
    "value": "The ncard transfer of encard_image_inter_le_encard_shatters, for A finite. Internal: the general statement is the encard one, which needs no hypothesis."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} {𝒜 : Set (Set α)} {A : Set α},\n  A.Finite → ((fun x => A ∩ x) '' 𝒜).ncard ≤ {B | B ⊆ A ∧ Shatters 𝒜 B}.ncard"
  },
  {
