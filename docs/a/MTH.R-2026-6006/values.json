  {
    "field": "dictionary_constant.kind",
    "value": "def"
  },
  {
    "field": "dictionary_constant.doc",
    "value": "A pattern is a pair pattern when it offers either no constraint or exactly two labels at each point. The two labels are recorded as a set, so their order carries no information."
  },
  {
    "field": "dictionary_constant.pretty",
    "value": "{X : Type u_1} → {Y : Type u_2} → (X → Set Y) → Prop"
  },
  {
