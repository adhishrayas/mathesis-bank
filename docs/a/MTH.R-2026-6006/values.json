    "field": "argument_node.doc",
    "value": "A family whose members each have, in every direction, a neighbour in the family is DS-shattered on the whole domain."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {X : Type u_1} {Y : Type u_2} {𝒞 : Set (X → Y)},\n  𝒞.Nonempty →\n    (Set.univ.restrict '' 𝒞).Finite →\n      (∀ c ∈ 𝒞, ∀ (i : X), ∃ c' ∈ 𝒞, c' i ≠ c i ∧ ∀ (j : X), j ≠ i → c' j = c j) → DSShatters 𝒞 Set.univ"
  },
