    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (N N' : ℕ → ℕ) (n : ℕ), (∀ i ≤ n, N i = N' i) → Cyl N n = Cyl N' n"
  },
  {
    "field": "dictionary_constant.name",
