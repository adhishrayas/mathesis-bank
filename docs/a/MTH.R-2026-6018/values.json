  {
    "field": "argument_node.doc",
    "value": "The intersection of closures of cylinder images equals the compact image. Key lemma for the capacitability proof: uses truncation and sequential compactness."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} [inst : TopologicalSpace α] [PolishSpace α] {f : (ℕ → ℕ) → α},\n  Continuous f → ∀ (N : ℕ → ℕ), ⋂ n, closure (f '' Cyl N n) = f '' Bnd N"
  },
  {
    "field": "dictionary_constant.name",
    "value": "Bnd"
  },
  {
    "field": "dictionary_constant.name",
    "value": "Cyl"
  },
  {
