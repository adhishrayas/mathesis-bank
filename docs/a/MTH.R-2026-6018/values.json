    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} [inst : TopologicalSpace α] {cap : Set α → ENNReal},\n  MeasureTheory.IsChoquetCapacity cap →\n    ∀ (f : ℕ → Set α), Antitone f → (∀ (n : ℕ), IsClosed (f n)) → cap (⋂ n, f n) = ⨅ n, cap (f n)"
  },
