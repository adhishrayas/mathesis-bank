  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} [inst : TopologicalSpace α] {cap : Set α → ENNReal},\n  MeasureTheory.IsChoquetCapacity cap → ∀ {s t : Set α}, s ⊆ t → cap s ≤ cap t"
  },
  {
    "field": "dictionary_constant.name",
