    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (N : ℕ → ℕ), IsCompact (Bnd N)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "Bnd"
  },
  {
    "field": "argument_node.decl_name",
    "value": "MeasureTheory.AnalyticSet.cap_eq_iSup_isCompact"
  },
  {
