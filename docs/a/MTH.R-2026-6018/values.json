  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (N g : ℕ → ℕ), choquetTruncate N g ∈ Bnd N"
  },
  {
    "field": "dictionary_constant.name",
    "value": "Bnd"
  },
  {
    "field": "dictionary_constant.name",
    "value": "choquetTruncate"
  },
  {
    "field": "argument_node.decl_name",
    "value": "iInter_closure_image_cyl_eq"
  },
  {
    "field": "argument_node.decl_name",
    "value": "truncate_agree_on_cyl"
  },
  {
    "field": "argument_node.kind",
    "value": "theorem"
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ (N : ℕ → ℕ) (n : ℕ), ∀ g ∈ Cyl N n, ∀ i ≤ n, choquetTruncate N g i = g i"
  },
  {
    "field": "dictionary_constant.name",
    "value": "Cyl"
  },
  {
    "field": "dictionary_constant.name",
    "value": "choquetTruncate"
