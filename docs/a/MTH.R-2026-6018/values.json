  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {α : Type u_1} [inst : TopologicalSpace α] {cap : Set α → ENNReal},\n  MeasureTheory.IsChoquetCapacity cap → ∀ (f : ℕ → Set α), Monotone f → cap (⋃ n, f n) = ⨆ n, cap (f n)"
  },
  {
    "field": "dictionary_constant.name",
    "value": "MeasureTheory.IsChoquetCapacity"
  },
  {
    "field": "argument_node.decl_name",
    "value": "MeasureTheory.AnalyticSet.cap_eq_iSup_isCompact"
