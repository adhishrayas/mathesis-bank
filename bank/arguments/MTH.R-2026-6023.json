  "nodes": [
    {
      "citable": true,
      "decl_name": "MeasureTheory.exists_analyticSet_not_measurableSet_real",
      "depth": 0,
      "dictionary_leaves": [
        "MeasureTheory.embedBaireReal"
      ],
      "doc": "**An analytic non-Borel subset of `ℝ`**: the image of the Baire-space witness under the\ncontinuous injection. Analyticity transfers along the continuous image; non-Borelness\ntransfers back along the injective preimage.",
      "is_root": true,
      "kind": "theorem",
      "pretty": "∃ A, MeasureTheory.AnalyticSet A ∧ ¬MeasurableSet A",
      "topo": 0,
      "type_sha256": "b7b3031e029277d4483eaf4dea2d56af35b02a453f3d88ae90b2ab5046927d07"
    },
    {
      "citable": true,
      "decl_name": "MeasureTheory.exists_analyticSet_not_measurableSet",
      "depth": 1,
      "dictionary_leaves": [],
      "doc": "**An analytic non-Borel subset of Baire space**: the projection of the diagonal witness.",
      "is_root": false,
      "kind": "theorem",
      "pretty": "∃ A, MeasureTheory.AnalyticSet A ∧ ¬MeasurableSet A",
      "topo": 1,
      "type_sha256": "b7b3031e029277d4483eaf4dea2d56af35b02a453f3d88ae90b2ab5046927d07"
    },
    {
      "citable": true,
      "decl_name": "MeasureTheory.exists_closed_proj_not_measurableSet",
      "depth": 2,
      "dictionary_leaves": [],
      "doc": "**A closed set with a non-Borel projection.** Diagonalize the universal closed set of\n`(ℕ → ℕ) × (ℕ → ℕ)`: were the projection Borel, its complement would be analytic, hence the\nprojection of a closed set, hence a section of the universal set — and evaluating that\nsection at its own parameter is contradictory.",
      "is_root": false,
      "kind": "theorem",
      "pretty": "∃ D, IsClosed D ∧ ¬MeasurableSet {x | ∃ y, (x, y) ∈ D}",
      "topo": 2,
      "type_sha256": "f5e043c94e8a1addb1b260cb544af251f9f981145a1d1229def8548531f50dc8"
    },
    {
      "citable": true,
      "decl_name": "MeasureTheory.exists_closed_universal_sections",
      "depth": 3,
      "dictionary_leaves": [],
      "doc": "**A universal closed set.** Every second-countable space `X` carries a closed subset of\n`X × (ℕ → ℕ)` whose sections run through all closed subsets of `X`: enumerate a countable\nbasis together with `∅`, and let the parameter select which basis elements to exclude.",
      "is_root": false,
      "kind": "theorem",
      "pretty": "∀ (X : Type u_1) [inst : TopologicalSpace X] [SecondCountableTopology X],\n  ∃ S, IsClosed S ∧ ∀ (C : Set X), IsClosed C → ∃ y, {x | (x, y) ∈ S} = C",
      "topo": 3,
      "type_sha256": "9e3b61e4625c3ff8dfce0ff823c131548a21c031dcf37278785f55e5d2b7f7b3"
    },
