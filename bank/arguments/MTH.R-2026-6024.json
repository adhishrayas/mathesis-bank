        "InformationTheory.klBin"
      ],
      "is_root": false,
      "kind": "theorem",
      "pretty": "∀ (p q : ℝ),\n  0 < q →\n    q < 1 →\n      InformationTheory.klBin p q =\n        q * InformationTheory.klFun (p / q) + (1 - q) * InformationTheory.klFun ((1 - p) / (1 - q))",
      "topo": 5,
      "type_sha256": "82cc618557a2deb66e2999bc3a5d6a6c21188eccf5dd3e49d76f23e8825a78cd"
    },
