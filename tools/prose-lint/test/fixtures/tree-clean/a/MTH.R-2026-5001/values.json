  {
    "field": "dictionary_constant.kind",
    "value": "def"
  },
  {
    "field": "dictionary_constant.doc",
    "value": "A concept is a function from domain to label. This is the atomic unit that concept classes collect and learners try to approximate."
  },
  {
    "field": "dictionary_constant.pretty",
    "value": "Type u → Type v → Type (max u v)"
  },
