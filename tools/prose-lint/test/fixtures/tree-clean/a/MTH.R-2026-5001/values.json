  {
    "field": "argument_node.doc",
    "value": "Codeword (cube b).val is in cubeBitSlice cube k iff b k = true."
  },
  {
    "field": "argument_node.pretty",
    "value": "∀ {X : Type u} {C : ConceptClass X Bool} {n : ℕ} {S : Finset ↑C} (cube : (Fin n → Bool) ↪ ↥S) (b : Fin n → Bool)\n  (k : Fin n), ↑(cube b) ∈ cubeBitSlice✝ cube k ↔ b k = true"
  },
