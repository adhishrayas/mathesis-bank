# The Mathlib deposit-build image, and the one-off exporter that produces its trusted reference.
#
#   # the runtime builder image an untrusted Mathlib deposit builds in
#   docker build -f deploy/builder/Dockerfile.mathlib \
#     -t mathesis/lean-builder:v4.31.0-mathlib-fabf563 deploy/builder
#
#   # the trusted reference for that environment (runs the exporter stage once)
#   bash deploy/builder/make-mathlib-export.sh
#
# WHY THIS IS A SEPARATE FILE FROM Dockerfile
# -------------------------------------------
# `Dockerfile` is the Lean-core image: the toolchain and nothing else. This one adds a specific
# Mathlib revision's prebuilt olean cache, so the image tag names the environment a deposit pins
# with `@mathlib` — `environments.builder_image` is exactly this tag. A deposit pinning a
# revision must get *that* revision's cache, never a near neighbour, so one image per revision
# is the unit, and mixing both into one file with a flag would blur that.
#
# THE SECURITY POSTURE IS THE CORE IMAGE'S, UNCHANGED
# ---------------------------------------------------
# This image also runs code submitted by strangers. Lean elaboration performs arbitrary IO at
# build time, so a deposit is arbitrary code execution by design. The confinement lives in
# `gate_deposit.sh`'s run flags (`--network none --read-only`, one writable mount, no inherited
# environment, cpu/memory/pids caps); this file's job is to give them nothing extra to reach.
#
# So the runtime stage is built by COPYING artifacts out of the fetch stage rather than by
# adding Mathlib on top of a working checkout. The final image therefore carries:
#
#   * no curl, no git, no gh, no cloud SDK — nothing that turns a forgotten `--network none`
#     into exfiltration;
#   * no Mathlib SOURCE and no `.git` — only compiled `.olean` files, which is all a build
#     needs to `import Mathlib`;
#   * no `lean4export` and no adjudicator.
#
# On that last point: the gate's export step DOES need lean4export together with this
# revision's oleans, so there is a second runtime image (`--target exportrt`) that is the
# builder plus that one binary. It is a separate image rather than a flag on this one because
# the untrusted build should be handed nothing it does not need. That is defence in depth, not
# a soundness boundary: `--read-only` already makes the binary untamperable, and
# `candidate.export` is untrusted input to the adjudicator either way. The adjudicator itself
# is in neither image — it stays on the trusted host, which is where the trust actually rests.
#
# `ci/test_gate_isolation.sh` asserts those properties against the real `gate_deposit.sh`
# invocation, and is image-independent — it drives whatever `MATHESIS_BUILDER_IMAGE` names.

ARG LEAN_VERSION=v4.31.0
# All 512 banked accessions pin this revision, and it is the commit that bumped Mathlib's own
# lean-toolchain to v4.31.0 — the fetch stage asserts that pairing rather than trusting it.
ARG MATHLIB_REV=fabf563a7c95a166b8d7b6efca11c8b4dc9d911f
# The same revision backend-gate/lake-manifest.json pins. The export format must be the one
# `loadFrozenText` parses, so this is not a free choice.
ARG LEAN4EXPORT_REV=ca36c44858e2d7ba40996203d2f08a69113d1211


# ── stage 1: the toolchain, Mathlib, and its prebuilt olean cache ─────────────────────────────
FROM debian:bookworm-slim AS fetch
ARG LEAN_VERSION
ARG MATHLIB_REV

ENV DEBIAN_FRONTEND=noninteractive \
    ELAN_HOME=/opt/elan \
    PATH=/opt/elan/bin:$PATH

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git; \
    curl -fsSL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
      -o /tmp/elan-init.sh; \
    sh /tmp/elan-init.sh -y --default-toolchain "leanprover/lean4:${LEAN_VERSION}" \
      --no-modify-path; \
    rm -f /tmp/elan-init.sh; \
    lean --version

# A single commit, no history. The revision is what identifies the environment; Mathlib's git
# history is several hundred MB that nothing downstream reads.
#
# The toolchain assertion is the point of this step: a Mathlib revision whose own lean-toolchain
# disagrees with the pin would produce oleans the gate's `@pin` can never match, and the failure
# would surface much later as "incompatible header" on a depositor's build.
RUN set -eux; \
    mkdir -p /mathlib; cd /mathlib; \
    git init -q; \
    git remote add origin https://github.com/leanprover-community/mathlib4.git; \
    git fetch -q --depth 1 origin "${MATHLIB_REV}"; \
    git checkout -q FETCH_HEAD; \
    got="$(tr -d '[:space:]' < lean-toolchain)"; \
    test "$got" = "leanprover/lean4:${LEAN_VERSION}" \
      || { echo "FATAL: mathlib ${MATHLIB_REV} wants $got, image pins ${LEAN_VERSION}"; exit 1; }

# The prebuilt olean cache. Building Mathlib from source is hours of CPU; `cache get` is a
# download of the same artifacts the Mathlib project publishes for that exact revision.
RUN set -eux; cd /mathlib; lake exe cache get

# `cache get` populates the cache but does not guarantee every target is present. `lake build`
# over a complete cache is close to a no-op and turns a partial cache into a loud failure here
# rather than an unresolved import inside a depositor's build.
RUN set -eux; cd /mathlib; lake build

# Flatten every package's olean tree into one directory so the runtime image needs a single
# LEAN_PATH entry. Top-level namespaces do not collide across Mathlib and its dependencies
# (Mathlib/, Batteries/, Aesop/, Qq/, ...), so a merge is safe and keeps the final image free of
# the surrounding source trees.
#
# Lake has moved oleans between `build/lib` and `build/lib/lean` across versions, so prefer the
# `lean` subdirectory when it exists rather than assuming either layout.
RUN set -eux; \
    mkdir -p /oleans; \
    for d in /mathlib/.lake/build/lib /mathlib/.lake/packages/*/.lake/build/lib; do \
      [ -d "$d" ] || continue; \
      if [ -d "$d/lean" ]; then src="$d/lean"; else src="$d"; fi; \
      cp -a "$src/." /oleans/; \
    done; \
    test -f /oleans/Mathlib.olean || { echo "FATAL: Mathlib.olean absent after cache+build"; exit 1; }; \
    chmod -R a+rX /oleans; \
    echo "olean tree:"; du -sh /oleans; \
    echo "Mathlib.olean: $(wc -c < /oleans/Mathlib.olean) bytes"

# The chmod above is load-bearing, not hygiene. `lake exe cache get` extracts oleans as 0600
# root:root, and `cp -a` preserves that, so the tree arrives in the runtime images readable by
# root alone — while both of those run as the unprivileged `builder` uid. Measured before the
# fix, a genuine Mathlib deposit died at:
#
#     failed to open file '/oleans/Mathlib/Logic/Basic.olean': Permission denied
#
# i.e. EVERY Mathlib deposit would have failed to build, and every export would have failed to
# resolve its imports. It is fixed here rather than after the COPY in runtime-base because a
# `chmod -R` there would rewrite all 6 GB into a second layer and double both images.
#
# Directories were already 0755, so only the files needed widening; `a+rX` is deliberate —
# capital X adds execute to directories only, never to olean files.


# ── stage 1b: the pruned trees the RUNTIME images carry ──────────────────────────────────────
# A separate stage, not a prune after the COPY. `COPY --from=<stage>` materialises that stage's
# merged filesystem, so deleted files are simply absent; deleting after the COPY would write
# whiteouts over a 6 GB lower layer that still ships, and a `chmod -R` there would copy up all
# 94k files into a second full layer.
#
# `exporter` below stays FROM `fetch`, i.e. UNPRUNED. The trusted reference must be produced
# from a complete environment, so pruning cannot weaken it even in principle.
#
# WHAT IS SAFE TO DROP, MEASURED
# ------------------------------
# Each was verified by exporting the same Mathlib deposit through the real gate and requiring a
# BYTE-IDENTICAL candidate (lean4export confirmed deterministic first), with the spoof still
# rejected:
#
#   .ilean            268 MB   language-server index; nothing at runtime opens it
#   .trace / .hash      2 MB   lake build bookkeeping; there is no lake at runtime
#   *.a               410 MB   static archives, used only to LINK a native executable. The
#                              runtime does `lean -o …olean` and `lean4export` — no linking
#   toolchains/*/src   34 MB   Lean source, for IDE hover
#   toolchains/*/ilean 80 MB   as above
#
# Roughly 1.0 GB, and 64% of the inode count, which is per-job pull and extract time.
#
# WHAT IS NOT SAFE, ALSO MEASURED — DO NOT RETRY
# ----------------------------------------------
# `.olean.private` is 3,449 MB here plus 1,259 MB in the toolchain: by far the largest target,
# and it CANNOT go. Lake describes a plain `import` as needing only `.olean`, `.olean.server`
# and `.ir` (lake/Lake/Build/Module.lean:250-251), but that describes what LAKE tracks as a
# build dependency, not what the runtime loader opens. Removing it fails at the very first
# import, before any Mathlib module is even reached:
#
#     /work/Submission.lean:1:0: error: missing data file for module Init
#
# The 2:1 size ratio over `.olean` is not slack; it is where the module data lives.
FROM fetch AS slim
RUN set -eux; \
    find /oleans \( -name "*.ilean" -o -name "*.trace" -o -name "*.hash" \) -delete; \
    find /opt/elan \( -name "*.a" -o -name "*.ilean" \) -delete; \
    rm -rf /opt/elan/toolchains/*/src /opt/elan/tmp; \
    test -f /oleans/Mathlib.olean || { echo "FATAL: prune removed Mathlib.olean"; exit 1; }; \
    echo "pruned trees:"; du -sh /oleans /opt/elan


# ── stage 2: the exporter — TRUSTED side, never shipped to a deposit ──────────────────────────
# Produces the `mathlib.export` that becomes `environments.mathlib_reference_sha256`. It lives
# in this file so the reference and the image it is the reference FOR are pinned by the same
# three ARGs and cannot drift apart.
FROM fetch AS exporter
ARG LEAN_VERSION
ARG LEAN4EXPORT_REV

RUN set -eux; \
    mkdir -p /l4e; cd /l4e; \
    git init -q; \
    git remote add origin https://github.com/leanprover/lean4export.git; \
    git fetch -q --depth 1 origin "${LEAN4EXPORT_REV}"; \
    git checkout -q FETCH_HEAD; \
    elan run "leanprover/lean4:${LEAN_VERSION}" lake build; \
    find /l4e -type f -name lean4export -perm -u+x | head -n1 > /l4e/.binpath; \
    test -s /l4e/.binpath || { echo "FATAL: lean4export exe not built"; exit 1; }; \
    echo "lean4export: $(cat /l4e/.binpath)"; \
    test -x /l4e/.lake/build/bin/lean4export || { \
      echo "FATAL: lean4export is not at the canonical lake path;"; \
      echo "       the exportrt stage COPYs that path and cannot read .binpath"; exit 1; }

# make-mathlib-export.sh supplies the command, so the export invocation stays in one readable
# place rather than split between a script and an ENTRYPOINT.


# ── stage 3: the runtime base, shared by the two images below ────────────────────────────────
# Both the deposit builder and the export runtime need the same toolchain and the same olean
# tree. They share it as layers, so the second image costs one small layer rather than another
# 6 GB.
FROM debian:bookworm-slim AS runtime-base

# Lean's runtime shared libraries, installed explicitly. The core image gets them incidentally
# as dependencies of its build-time packages; relying on that here would make the image's
# ability to run `lean` a side effect of an unrelated `apt-get purge`.
#
# No curl and no git, deliberately — see the header.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libgmp10 libstdc++6; \
    rm -rf /var/lib/apt/lists/*

COPY --from=slim /opt/elan /opt/elan
COPY --from=slim /oleans /oleans

# LEAN_PATH is how the deposit's `import Mathlib` resolves. `gate_deposit.sh` invokes
# `lean --root=/work` with no LEAN_PATH of its own — by design, so the Lean-core image gives a
# build the toolchain's Init/Std/Lean and nothing more. For a Mathlib environment the image
# supplies the path, which keeps "what a deposit may import" a property of the environment it
# pinned rather than of the caller's environment.
ENV ELAN_HOME=/opt/elan \
    PATH=/opt/elan/bin:$PATH \
    LEAN_PATH=/oleans

# Non-root. The scratch mount is bind-mounted with the host's ownership, so the uid must be able
# to write it; gate_deposit.sh sets HOME=/work for the same reason.
RUN useradd --create-home --uid 10001 builder

# Assert the toolchain runs AND that the oleans are readable BY THE USER THAT WILL RUN — not by
# root, which is what a bare `test -f` here would have proved. That distinction is the whole
# bug: the tree was root-only and every Mathlib deposit failed at `import Mathlib` with
# "Permission denied", while every root-run check passed happily.
RUN set -eux; \
    lean --version; \
    test -f /oleans/Mathlib.olean; \
    su builder -s /bin/sh -c 'test -r /oleans/Mathlib.olean' \
      || { echo "FATAL: /oleans is not readable by the unprivileged build user"; exit 1; }

WORKDIR /work


# ── stage 4 (default, last): the deposit builder image ───────────────────────────────────────
# Last, so a bare `docker build -f Dockerfile.mathlib` produces the image that runs untrusted
# code rather than one carrying extra tools.
#
# The EXPORT runtime used to be a sibling stage here (`FROM runtime-base AS exportrt`). It has
# moved to deploy/builder/Dockerfile.exportrt, which builds FROM this image by tag. The two
# differ by one 246 MB binary and must share every layer beneath it; as sibling stages built by
# two separate `docker build` invocations they did not — measured at 22.7 GB resident for the
# pair, against ~14 GB of runner disk. See that file for the full reasoning.
FROM runtime-base
USER builder
WORKDIR /work

# No ENTRYPOINT: gate_deposit.sh supplies the full command, including its own `timeout`, so the
# invocation stays visible in one place rather than split between here and the caller.
