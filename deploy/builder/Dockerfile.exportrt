# The EXPORT runtime: the deposit builder image, plus `lean4export`.
#
#   docker build -f deploy/builder/Dockerfile.exportrt \
#     --build-arg BUILDER_IMAGE=mathesis/lean-builder:v4.31.0-mathlib-fabf563 \
#     --build-arg EXPORTER_IMAGE=mathesis/lean-exporter:v4.31.0-mathlib-fabf563 \
#     -t mathesis/lean-exporter-rt:v4.31.0-mathlib-fabf563 deploy/builder
#
# `environments.export_image` names this image, and `ci/gate_deposit.sh` runs its export step
# here because only a Mathlib image has that revision's oleans — the host has none, and
# `lean4export Submission` there dies with "unknown module prefix 'Mathlib'".
#
# WHY THIS IS A SEPARATE FILE RATHER THAN A STAGE
# -----------------------------------------------
# This image and the deposit builder differ by one 246 MB binary, so they should share every
# layer underneath it. They did not. Both were stages `FROM runtime-base` in Dockerfile.mathlib —
# siblings — and `make-mathlib-export.sh` builds them as two separate `docker build`
# invocations. Even run back to back against a warm cache, those two builds materialised
# `runtime-base` twice with different layer digests. Measured on the result:
#
#     builder   12.2 GB   unique 10.2 GB
#     exportrt  12.5 GB   unique 10.5 GB      shared between them: 2.04 GB
#     both resident: 22.7 GB, on a runner with ~14 GB of disk
#
# The layer stacks diverged from position 2, with only three digests in common. Making exportrt
# a stage `FROM builder` would have left that outcome dependent on cache behaviour that had
# already failed once, and silently: nothing measures it.
#
# Building FROM the builder IMAGE, by tag, removes the question. exportrt's base layers are
# literally the builder's layers — there is no cache involved and no way for them to diverge.
# The check that distinguishes the two designs is in `make-mathlib-export.sh`: the builder's
# layer list must be a strict PREFIX of this image's.
#
# The security property is unchanged, and stronger by construction: the deposit builder is the
# BASE here, so it cannot contain `lean4export`. Previously that was a property of which stage
# copied what; now it is a property of the direction the images are built in.
ARG EXPORTER_IMAGE
ARG BUILDER_IMAGE

# The trusted exporter, used only as a source for the binary. It carries Mathlib's source and
# build tree and is never shipped to a deposit; nothing from it survives into the final image
# except the one executable copied below.
FROM ${EXPORTER_IMAGE} AS exporter

FROM ${BUILDER_IMAGE}
USER root
COPY --from=exporter /l4e/.lake/build/bin/lean4export /usr/local/bin/lean4export

# The binary's RPATH names /opt/elan, which the builder image carries at the same path, so it
# resolves here. It would not have resolved had the host's binary been mounted in instead — the
# host and the image do not share a glibc, which is why this is copied from an image built on
# the same base rather than bind-mounted at run time.
RUN set -eux; \
    test -x /usr/local/bin/lean4export; \
    if ldd /usr/local/bin/lean4export 2>/dev/null | grep -q "not found"; then \
      echo "FATAL: lean4export has unresolved shared libraries in this image"; \
      ldd /usr/local/bin/lean4export; exit 1; \
    fi

# Back to the unprivileged uid the builder image runs as. `gate_deposit.sh` mounts the scratch
# dir read-only for the export step and sets HOME=/tmp, so nothing here needs to write.
USER builder
WORKDIR /work
