{
  "version": 1,
  "base": {
    "elements": [
      "p", "br", "hr", "strong", "em", "del", "code", "pre", "blockquote",
      "ul", "ol", "li", "h3", "h4", "h5", "h6",
      "table", "thead", "tbody", "tr", "th", "td",
      "a", "sup", "sub"
    ],
    "attributes": {
      "a": ["href"]
    },
    "url_schemes": ["http", "https", "mailto"],
    "forced_rel": "nofollow noopener noreferrer"
  },
  "profiles": {
    "note": {
      "consumer": "gateway",
      "adds": [],
      "removes": []
    },
    "about": {
      "consumer": "prose-lint",
      "adds": ["h2"],
      "removes": []
    }
  }
}
